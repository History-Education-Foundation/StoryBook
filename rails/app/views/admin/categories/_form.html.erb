<%= form_with model: [:admin, category], html: { id: category.new_record? ? "new_category_form" : dom_id(category, :form) }, data: { turbo_stream: true }, class: "contents" do |f| %>
  <tr class="bg-slate-50 border-b border-slate-100">
    <td class="py-6 px-8">
      <%= f.text_field :name, placeholder: "Taxonomy Name", class: "input bg-white border-slate-200 focus:border-[#f9a825] focus:ring-[#f9a825] input-sm w-full font-bold text-slate-900 placeholder:text-slate-300 uppercase tracking-wider", required: true %>
    </td>
    <td class="py-6 px-8 text-right">
      <div class="flex justify-end gap-2">
        <%= f.button type: :submit, class: "btn bg-[#f9a825] hover:bg-[#f57f17] border-none text-white btn-sm px-6 font-bold" do %>
          <i class="fas fa-folder-plus mr-2"></i> <%= category.new_record? ? "Create" : "Update" %>
        <% end %>
        <% unless category.new_record? %>
          <%= link_to admin_category_path(category), class: "btn btn-ghost btn-sm text-slate-400 hover:bg-slate-200" do %>
            <i class="fas fa-times"></i>
          <% end %>
        <% end %>
      </div>
    </td>
  </tr>
<% end %>
