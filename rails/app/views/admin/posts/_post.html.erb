<%= turbo_frame_tag dom_id(post), tag: :tr, class: "hover:bg-slate-50/80 transition-colors" do %>
  <td class="py-6 px-8">
    <div class="font-bold text-slate-900"><%= post.title %></div>
    <div class="text-xs text-slate-500 mt-1"><%= truncate(post.body, length: 60) %></div>
  </td>
  <td class="py-6 text-slate-600 font-medium">
    <div class="flex items-center gap-2">
      <div class="w-6 h-6 bg-slate-200 rounded-full flex items-center justify-center text-[10px] text-slate-500 font-bold">
        <%= (post.author&.name || "N").first.upcase %>
      </div>
      <%= post.author&.name || "N/A" %>
    </div>
  </td>
  <td class="py-6">
    <% if post.category %>
      <div class="badge bg-slate-100 border-none text-slate-600 font-bold px-3 py-3"><%= post.category.name %></div>
    <% else %>
      <div class="text-slate-300 italic text-sm">Uncategorized</div>
    <% end %>
  </td>
  <td class="py-6 px-8 text-right">
    <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
      <%= link_to edit_admin_post_path(post), class: "btn btn-ghost btn-sm text-[#f9a825] hover:bg-[#f9a825]/10", data: { turbo_frame: dom_id(post) } do %>
        <i class="fas fa-pen-nib"></i>
      <% end %>
      <%= button_to admin_post_path(post), method: :delete, data: { turbo_confirm: "Are you sure you want to archive this post?", turbo_stream: true }, class: "btn btn-ghost btn-sm text-slate-300 hover:text-error hover:bg-error/10" do %>
        <i class="fas fa-trash-alt"></i>
      <% end %>
    </div>
  </td>
<% end %>
