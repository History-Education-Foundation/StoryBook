<%= turbo_frame_tag dom_id(@post), tag: :tr do %>
  <td colspan="4">
    <%= form_with model: [:admin, @post], data: { turbo_stream: true }, class: "space-y-3 p-4 bg-base-200 rounded-lg" do |f| %>
      <div class="grid grid-cols-2 gap-4">
        <div class="space-y-2">
          <%= f.label :title, class: "label label-text pb-0" %>
          <%= f.text_field :title, class: "input input-bordered input-sm w-full" %>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div class="space-y-2">
            <%= f.label :author_id, class: "label label-text pb-0" %>
            <%= f.collection_select :author_id, Author.all, :id, :name, { prompt: "Select Author" }, { class: "select select-bordered select-sm w-full" } %>
          </div>
          <div class="space-y-2">
            <%= f.label :category_id, class: "label label-text pb-0" %>
            <%= f.collection_select :category_id, Category.all, :id, :name, { prompt: "Select Category" }, { class: "select select-bordered select-sm w-full" } %>
          </div>
        </div>
      </div>
      <div class="space-y-2">
        <%= f.label :body, class: "label label-text pb-0" %>
        <%= f.text_area :body, class: "textarea textarea-bordered textarea-sm w-full", rows: 3 %>
      </div>
      <div class="flex justify-end gap-2">
        <%= f.submit "Save Changes", class: "btn btn-primary btn-sm" %>
        <%= link_to "Cancel", admin_post_path(@post), class: "btn btn-ghost btn-sm" %>
      </div>
    <% end %>
  </td>
<% end %>
