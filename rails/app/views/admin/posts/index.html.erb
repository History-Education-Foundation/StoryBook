<% content_for :full_width, true %>
<% content_for :hide_header, true %>
<% content_for :hide_navbar, true %>

<div class="min-h-screen bg-slate-50 font-sans text-slate-800">
  <%= render 'layouts/navigation' %>

  <!-- Hero/Header Section (Scholars Vibe) -->
  <section class="bg-slate-900 py-16 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute inset-0 bg-[#f9a825]/10 mix-blend-overlay"></div>
    </div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
      <div class="flex flex-col md:flex-row justify-between items-center gap-8">
        <div class="text-center md:text-left">
          <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Blog Dashboard</h1>
          <p class="text-xl text-slate-300 max-w-2xl leading-relaxed">
            Manage your educational content, organize categories, and coordinate with authors to build a comprehensive history resource.
          </p>
        </div>
        
        <div class="flex gap-4">
          <div class="bg-white/5 backdrop-blur-md border border-white/10 p-6 rounded-2xl text-center min-w-[140px]">
            <div class="text-[#f9a825] text-3xl font-bold mb-1"><%= @posts.count %></div>
            <div class="text-white/60 text-xs uppercase tracking-widest font-bold">Total Posts</div>
          </div>
          <div class="bg-white/5 backdrop-blur-md border border-white/10 p-6 rounded-2xl text-center min-w-[140px]">
            <div class="text-[#f9a825] text-3xl font-bold mb-1"><%= @categories.count %></div>
            <div class="text-white/60 text-xs uppercase tracking-widest font-bold">Categories</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Section -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Posts Section -->
      <div class="lg:col-span-12">
        <div class="bg-white rounded-3xl shadow-sm border border-slate-200 overflow-hidden">
          <div class="bg-slate-50 px-8 py-6 border-b border-slate-200 flex justify-between items-center">
            <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-3">
              <i class="fas fa-file-signature text-[#f9a825]"></i>
              Content Management
            </h2>
            <div class="badge bg-[#f9a825] border-none text-white font-bold p-3">Admin Access</div>
          </div>
          
          <%= turbo_frame_tag "posts_admin" do %>
            <div class="overflow-x-auto">
              <table class="table w-full">
                <thead>
                  <tr class="text-slate-400 uppercase text-[11px] tracking-[0.2em] font-bold border-b border-slate-100">
                    <th class="bg-white py-6 px-8">Post Details</th>
                    <th class="bg-white py-6">Author</th>
                    <th class="bg-white py-6">Category</th>
                    <th class="bg-white py-6 text-right px-8">Actions</th>
                  </tr>
                </thead>
                <tbody id="new_post_row">
                  <%= render partial: "admin/posts/form", locals: { post: @post } %>
                </tbody>
                <tbody id="posts">
                  <%= render partial: "admin/posts/post", collection: @posts, as: :post %>
                </tbody>
              </table>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Authors Section -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-3xl shadow-sm border border-slate-200 h-full overflow-hidden">
          <div class="bg-slate-50 px-8 py-6 border-b border-slate-200">
            <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-3">
              <i class="fas fa-user-tie text-[#f9a825]"></i>
              Authors
            </h2>
          </div>

          <%= turbo_frame_tag "authors_admin" do %>
            <div class="overflow-x-auto">
              <table class="table w-full">
                <thead>
                  <tr class="text-slate-400 uppercase text-[11px] tracking-[0.2em] font-bold border-b border-slate-100">
                    <th class="bg-white py-6 px-8">Contributor</th>
                    <th class="bg-white py-6">Expertise/Bio</th>
                    <th class="bg-white py-6 text-right px-8">Actions</th>
                  </tr>
                </thead>
                <tbody id="new_author_row">
                  <%= render partial: "admin/authors/form", locals: { author: @author } %>
                </tbody>
                <tbody id="authors">
                  <%= render partial: "admin/authors/author", collection: @authors, as: :author %>
                </tbody>
              </table>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Categories Section -->
      <div class="lg:col-span-5">
        <div class="bg-white rounded-3xl shadow-sm border border-slate-200 h-full overflow-hidden">
          <div class="bg-slate-50 px-8 py-6 border-b border-slate-200">
            <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-3">
              <i class="fas fa-folder-tree text-[#f9a825]"></i>
              Taxonomy
            </h2>
          </div>

          <%= turbo_frame_tag "categories_admin" do %>
            <div class="overflow-x-auto">
              <table class="table w-full">
                <thead>
                  <tr class="text-slate-400 uppercase text-[11px] tracking-[0.2em] font-bold border-b border-slate-100">
                    <th class="bg-white py-6 px-8">Category Name</th>
                    <th class="bg-white py-6 text-right px-8">Actions</th>
                  </tr>
                </thead>
                <tbody id="new_category_row">
                  <%= render partial: "admin/categories/form", locals: { category: @category } %>
                </tbody>
                <tbody id="categories">
                  <%= render partial: "admin/categories/category", collection: @categories, as: :category %>
                </tbody>
              </table>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer CTA (Scholars Style) -->
  <section class="py-16 bg-[#f9a825] text-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-4 italic">“Education is the most powerful weapon which you can use to change the world.”</h2>
      <p class="text-xl mb-8 text-white/90">— Nelson Mandela</p>
      <%= link_to root_path, class: "btn btn-outline text-white border-2 border-white hover:bg-white hover:text-slate-900 px-10 rounded-md transition-all font-bold" do %>
        Return to Site
      <% end %>
    </div>
  </section>
</div>