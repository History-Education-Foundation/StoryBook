<%# app/views/civic_topics/_lesson_plan_detail.html.erb %>
<%# Expected local: civic_topic %>

<%
  handout_url = "https://www.learner.org/wp-content/uploads/2019/07/RWD.HSSU8_.SACHandouts.pdf"
  show_pdf = [9, 40].include?(civic_topic&.id) || civic_topic&.handout_pdf&.attached?
  pdf_src = civic_topic.handout_pdf.attached? ? url_for(civic_topic.handout_pdf) : handout_url

  # Extract ALL slides from ALL fields to show them together
  all_content = [civic_topic.bio, civic_topic.legacy, civic_topic.main_ideas, civic_topic.criticism].join("\n")
  # Use a more specific regex to avoid matching directory names (like chile_cold_war)
  all_slides = all_content.scan(/Image:\s*([^\n]*(?:\/|^)(?:slide_|allende_|appeal_|cold_war_|why_|summary)[^\n]+)/i).flatten.map(&:strip).uniq

  master_slides_html = if all_slides.any?
    deck_id = "master_deck_#{civic_topic.id}"
    content_tag(:div, class: "flex h-[600px] md:h-[800px] bg-slate-900 rounded-[3rem] overflow-hidden shadow-2xl border-4 border-slate-900 my-12 group/deck relative") do
      # Left Sidebar: Thumbnails
      thumbnails = content_tag(:div, class: "w-24 md:w-48 overflow-y-auto bg-slate-800/80 p-4 space-y-4 border-r border-white/5 hidden sm:block scrollbar-hide") do
        all_slides.map.with_index do |img_url, idx|
          content_tag(:a, href: "##{deck_id}_slide_#{idx}", class: "block rounded-xl overflow-hidden border-2 border-transparent hover:border-[#f9a825] transition-all opacity-50 hover:opacity-100") do
            image_tag(img_url, class: "w-full aspect-[4/3] object-cover bg-white")
          end
        end.join.html_safe
      end

      # Main Content: Slides
      slides = content_tag(:div, class: "flex-grow overflow-y-auto bg-slate-900/50 scroll-smooth p-6 md:p-16 space-y-16") do
        all_slides.map.with_index do |img_url, idx|
          content_tag(:div, id: "#{deck_id}_slide_#{idx}", class: "w-full flex flex-col items-center gap-4") do
            content_tag(:div, class: "w-full bg-white shadow-2xl rounded-2xl overflow-hidden relative group/slide") do
              concat(image_tag(img_url, class: "w-full h-auto object-contain", alt: "Slide #{idx + 1}"))
              concat(content_tag(:div, class: "absolute bottom-4 right-4 z-20") do
                content_tag(:span, "Slide #{idx + 1} / #{all_slides.length}", class: "bg-slate-900/60 backdrop-blur-md text-white px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest border border-white/10")
              end)
            end
          end
        end.join.html_safe
      end

      concat(thumbnails)
      concat(slides)
    end
  end

  pdf_block_html = if show_pdf
    card = content_tag(:div, class: "my-12 bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm flex items-center gap-6 group hover:border-[#f9a825] transition-colors") do
      concat(content_tag(:div, class: "w-16 h-16 rounded-2xl bg-[#f9a825]/10 flex items-center justify-center text-[#f9a825] group-hover:bg-[#f9a825] group-hover:text-slate-900 transition-colors") { content_tag(:i, "", class: "fas fa-file-pdf text-2xl") })
      concat(content_tag(:div, class: "flex-grow") do
        concat(content_tag(:h4, "Lesson Handout Available", class: "text-slate-900 font-bold text-lg mb-1"))
        concat(content_tag(:p, "Review or download the student activity sheet below.", class: "text-slate-500 text-sm mb-0"))
      end)
      concat(link_to(pdf_src, class: "btn btn-circle bg-slate-900 border-none text-white hover:bg-[#f9a825] hover:text-slate-900 shadow-lg", target: "_blank") { content_tag(:i, "", class: "fas fa-arrow-down") })
    end

    viewer = content_tag(:div, class: "w-full h-[600px] md:h-[800px] bg-slate-900 rounded-[2.5rem] overflow-hidden shadow-2xl border-4 border-slate-900 my-10 relative group") do
      content_tag(:iframe, "", 
        src: "#{pdf_src}#pagemode=thumbs&view=FitH", 
        class: "w-full h-full bg-white",
        style: "border: none;",
        title: "Lesson Handout Preview")
    end
    
    (card + viewer).html_safe
  end

  def render_lesson_content(text, civic_topic = nil, options = {})
    return "" if text.blank?
    
    # PRE-PROCESSING: Fix smashed labels and ensure structural labels have double newlines
    # Fix "Grade: XTime:" -> "Grade: X\n\nTime:"
    text = text.gsub(/Grade:\s*([^\n]+)(Time:)/i, "Grade: \\1\n\n\\2")
    text = text.gsub(/Time:\s*([^\n]+)(Standards Alignment)/i, "Time: \\1\n\n\\2")
    
    # Ensure major sections have double newlines if they are smashed
    labels = ["Learning Objectives", "Key Vocabulary", "Hook", "Mini-Lesson", "Activity", "Guided Activity", "Discussion Question", "Discussion Questions", "Reality Check", "Exit Ticket", "Optional Extension"]
    labels.each do |label|
      text = text.gsub(/([^\n])(#{label}[:\(])/i, "\\1\n\n\\2")
    end

    # Text color defaults based on dark mode option
    primary_text = options[:dark_mode] ? "text-white" : "text-slate-900"
    secondary_text = options[:dark_mode] ? "text-white/70" : "text-slate-700"
    muted_text = options[:dark_mode] ? "text-white/40" : "text-slate-500"
    
    # Split by double newline to get blocks
    blocks = text.split("\n\n")
    
    html = blocks.map do |block|
      # Extract and render media first (Images and Videos)
      media_html = ""
      temp_block = block.dup
      
      # Match Image: or Video: followed by a URL/filename
      media_matches = temp_block.scan(/(?:Image|Video):\s*([^\n]+)/i)
      if media_matches.any?
        content_urls = media_matches.flatten.map(&:strip)
        
        # FILTER: Ignore URLs that are part of the main slide deck
        images = content_urls.select { |url| url.match?(/\.(jpg|jpeg|png|gif|webp|avif|svg)/i) }
        images = images.reject { |url| url.downcase.match?(/(\/|^)(slide_|allende_|appeal_|cold_war_|why_|summary)/) } # Don't render slides inline
        
        # Clean image URLs to handle "Title: image.jpg"
        images = images.map do |img_url|
          if img_url.include?(":") && !img_url.start_with?("http")
            img_url.split(":").last.strip
          else
            img_url
          end
        end

        videos = content_urls.reject { |url| url.match?(/\.(jpg|jpeg|png|gif|webp|avif|svg)/i) }
        
        if images.any?
          if images.size == 1
            # Render a single regular image with high-fidelity styling
            media_html += content_tag(:div, class: "my-12 relative group") do
              content_tag(:div, class: "overflow-hidden rounded-[2.5rem] shadow-2xl border-4 border-white bg-white") do
                image_tag(images.first, class: "w-full h-auto object-contain hover:scale-[1.02] transition-transform duration-700")
              end
            end
          else
            # Render multiple images as a mini-deck
            deck_id = "deck_#{SecureRandom.hex(4)}"
            media_html += content_tag(:div, class: "flex h-[600px] md:h-[800px] bg-slate-900 rounded-[3rem] overflow-hidden shadow-2xl border-4 border-slate-900 my-12 group/deck relative") do
              # Left Sidebar: Thumbnails
              thumbnails = content_tag(:div, class: "w-24 md:w-48 overflow-y-auto bg-slate-800/80 p-4 space-y-4 border-r border-white/5 hidden sm:block") do
                images.map.with_index do |img_url, idx|
                  content_tag(:a, href: "##{deck_id}_slide_#{idx}", class: "block rounded-xl overflow-hidden border-2 border-transparent hover:border-[#f9a825] transition-all opacity-50 hover:opacity-100") do
                    image_tag(img_url, class: "w-full aspect-[4/3] object-cover bg-white")
                  end
                end.join.html_safe
              end

              # Main Content: Slides
              slides = content_tag(:div, class: "flex-grow overflow-y-auto bg-slate-900/50 scroll-smooth p-6 md:p-16 space-y-16") do
                images.map.with_index do |img_url, idx|
                  content_tag(:div, id: "#{deck_id}_slide_#{idx}", class: "w-full flex flex-col items-center gap-4") do
                    content_tag(:div, class: "w-full bg-white shadow-2xl rounded-2xl overflow-hidden relative group/slide") do
                      concat(image_tag(img_url, class: "w-full h-auto object-contain", alt: "Slide #{idx + 1}"))
                      concat(content_tag(:div, class: "absolute bottom-4 right-4 z-20") do
                        content_tag(:span, "Slide #{idx + 1}", class: "bg-slate-900/60 backdrop-blur-md text-white px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest border border-white/10")
                      end)
                    end
                  end
                end.join.html_safe
              end

              concat(thumbnails)
              concat(slides)
            end
          end
        end
        
        if videos.any?
          media_html += videos.map do |video_url|
            # Extract only the URL part if there is surrounding text
            video_src = if video_url.match?(%r{https?://})
              video_url.match(%r{https?://[^\s]+})[0]
            else
              video_url
            end

            if video_src.include?("youtube.com/watch?v=")
              video_src = video_src.gsub("youtube.com/watch?v=", "youtube.com/embed/")
            elsif video_src.include?("youtu.be/")
              video_src = video_src.gsub("youtu.be/", "youtube.com/embed/")
            end

            content_tag(:div, class: "my-10 aspect-video bg-slate-900 rounded-[2.5rem] overflow-hidden shadow-2xl border-4 border-slate-900 group/video relative") do
              content_tag(:iframe, "", 
                src: video_src, 
                class: "w-full h-full relative z-10",
                frameborder: "0", 
                allow: "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share", 
                referrerpolicy: "strict-origin-when-cross-origin", 
                allowfullscreen: true)
            end
          end.join
        end
        
        # Remove media lines from the block so they don't get rendered as text
        temp_block = temp_block.gsub(/(?:Image|Video):\s*[^\n]+\n?/i, "").strip
      end

      lines = temp_block.split("\n")

      block_html = if temp_block.match?(/Grade:|Time:|Standards Alignment/i)
        # Style lesson metadata
        content_tag(:div, class: "grid grid-cols-1 md:grid-cols-3 gap-6 my-12") do
          temp_block.split("\n").map do |line|
            next if line.blank?
            label, val = if line.include?(":")
              line.split(":", 2)
            else
              [nil, line]
            end
            
            if label
              content_tag(:div, class: "bg-white p-6 rounded-[2.5rem] flex flex-col gap-2 border-2 border-slate-100 shadow-sm hover:border-[#f9a825]/30 transition-all group/meta") do
                icon = case label.downcase
                  when /grade/ then "fa-graduation-cap"
                  when /time/ then "fa-clock"
                  when /standards/ then "fa-check-circle"
                  else "fa-info-circle"
                end
                concat(content_tag(:div, class: "w-10 h-10 rounded-2xl bg-[#f9a825]/10 flex items-center justify-center text-[#f9a825] group-hover/meta:bg-[#f9a825] group-hover/meta:text-slate-900 transition-colors") { content_tag(:i, "", class: "fas #{icon} text-sm") })
                concat(content_tag(:span, label.strip, class: "text-slate-400 font-black uppercase tracking-widest text-[9px]"))
                concat(content_tag(:span, val.strip, class: "text-slate-900 font-black text-lg tracking-tight"))
              end
            else
              content_tag(:div, line, class: "text-slate-500 italic text-sm w-full col-span-full text-center")
            end
          end.join.html_safe
        end
      elsif temp_block.match?(/Learning Objectives|Key Vocabulary/i)
        # Style headers
        content_tag(:div, class: "mt-16 mb-8") do
          concat(content_tag(:h4, temp_block.strip, class: "text-3xl font-black text-slate-900 uppercase tracking-tighter border-b-[6px] border-[#f9a825] pb-2 inline-block"))
        end
      elsif temp_block.match?(/Mini-Lesson:/i)
        content = temp_block.gsub(/Mini-Lesson:/i, "").strip
        content_tag(:div, class: "bg-gradient-to-r from-[#f9a825]/20 to-transparent border-l-8 border-[#f9a825] p-10 my-12 rounded-r-[2.5rem] shadow-xl group/mini transition-all hover:scale-[1.01]") do
          concat(content_tag(:div, class: "flex items-center gap-4 mb-6") do
            concat(content_tag(:div, class: "w-12 h-12 rounded-2xl bg-[#f9a825] flex items-center justify-center text-slate-900 shadow-[0_10px_20px_rgba(249,168,37,0.3)] group-hover/mini:rotate-6 transition-transform") { content_tag(:i, "", class: "fas fa-chalkboard-teacher text-lg") })
            concat(content_tag(:span, "Teacher Mini-Lesson", class: "text-[#f9a825] font-black uppercase tracking-[0.3em] text-xs"))
          end)
          concat(content_tag(:div, simple_format(content), class: "text-slate-800 font-bold text-2xl leading-tight [&>p]:m-0"))
        end
      elsif temp_block.match?(/Activity:/i)
        content = temp_block.gsub(/Activity:/i, "").strip
        content_tag(:div, class: "bg-slate-900 border-l-8 border-[#f9a825] p-12 my-16 rounded-r-[3rem] shadow-2xl relative overflow-hidden group/act transition-all hover:scale-[1.01]") do
          concat(content_tag(:div, class: "absolute top-0 right-0 p-12 opacity-10 group-hover/act:scale-125 transition-transform duration-700") { content_tag(:i, "", class: "fas fa-running text-8xl text-white") })
          concat(content_tag(:div, class: "relative z-10") do
            concat(content_tag(:div, class: "flex items-center gap-4 mb-8") do
              concat(content_tag(:div, class: "w-12 h-12 rounded-2xl bg-[#f9a825] flex items-center justify-center text-slate-900 shadow-lg group-hover/act:rotate-6 transition-transform") { content_tag(:i, "", class: "fas fa-users text-lg") })
              concat(content_tag(:span, "Student Activity Block", class: "text-[#f9a825] font-black uppercase tracking-[0.4em] text-xs"))
            end)
            concat(content_tag(:div, simple_format(content), class: "text-white font-bold text-3xl leading-relaxed [&>p]:m-0 tracking-tight"))
          end)
        end
      elsif temp_block.match?(/Discussion:/i)
        content = temp_block.gsub(/Discussion:/i, "").strip
        bg_class = options[:dark_mode] ? "bg-white/5 border-white/10" : "bg-slate-50 border-slate-200"
        text_color = options[:dark_mode] ? "text-white" : "text-slate-800"
        header_bg = options[:dark_mode] ? "bg-white/10" : "bg-white"
        header_text = options[:dark_mode] ? "text-white/60" : "text-slate-400"
        
        content_tag(:div, class: "#{bg_class} border-l-8 border-slate-300 p-10 my-12 rounded-r-[2.5rem] shadow-sm group/disc transition-all hover:bg-white") do
          concat(content_tag(:div, class: "flex items-center gap-4 mb-6") do
            concat(content_tag(:div, class: "w-12 h-12 rounded-2xl #{header_bg} border border-slate-100 flex items-center justify-center #{header_text} shadow-sm group-hover/disc:rotate-6 transition-transform") { content_tag(:i, "", class: "fas fa-comments text-lg") })
            concat(content_tag(:span, "Discussion Question", class: "#{header_text} font-black uppercase tracking-[0.3em] text-xs"))
          end)
          concat(content_tag(:div, simple_format(content), class: "#{text_color} font-serif text-2xl italic leading-relaxed [&>p]:m-0"))
        end
      elsif temp_block.match?(/Point:|Goal:|Core Tip:/i)
        # Style important callouts within sections
        marker = temp_block.match(/Point:|Goal:|Core Tip:/i)[0]
        content = temp_block.gsub(/#{marker}/i, "").strip
        bg_class = options[:dark_mode] ? "bg-white/5 border-white/10" : "bg-[#f9a825]/5 border-[#f9a825]/20"
        content_tag(:div, class: "#{bg_class} border p-6 my-6 rounded-2xl flex items-start gap-4") do
          concat(content_tag(:div, class: "w-10 h-10 rounded-lg bg-[#f9a825] flex items-center justify-center text-slate-900 shadow-sm flex-shrink-0 mt-1") do
            content_tag(:i, "", class: "fas fa-star text-sm")
          end)
          concat(content_tag(:div) do
            concat(content_tag(:span, marker.gsub(":", ""), class: "text-[#f9a825] font-black uppercase tracking-widest text-[10px] block mb-1"))
            concat(content_tag(:div, simple_format(content), class: "#{primary_text} font-bold text-lg leading-snug [&>p]:m-0"))
          end)
        end
      elsif temp_block.match?(/Essential Question:/i)
        content = temp_block.gsub(/Essential Question:/i, "").strip
        content_tag(:div, class: "bg-[#f9a825] text-slate-900 p-8 my-10 rounded-[2.5rem] shadow-xl relative overflow-hidden group") do
          concat(content_tag(:div, class: "absolute -right-4 -top-4 opacity-10 group-hover:scale-110 transition-transform") { content_tag(:i, "", class: "fas fa-question-circle text-[10rem]") })
          concat(content_tag(:div, class: "relative z-10") do
            concat(content_tag(:div, class: "flex items-center gap-3 mb-4") do
              concat(content_tag(:div, class: "w-8 h-8 rounded-full bg-slate-900 flex items-center justify-center text-[#f9a825]") { content_tag(:i, "", class: "fas fa-lightbulb text-xs") })
              concat(content_tag(:span, "Essential Question", class: "text-slate-900 font-black uppercase tracking-[0.3em] text-xs"))
            end)
            concat(content_tag(:h2, content, class: "text-slate-900 font-black text-3xl leading-tight italic tracking-tighter"))
          end)
        end
      elsif temp_block.match?(/Hook:/i)
        content = temp_block.gsub(/Hook:/i, "").strip
        content_tag(:div, class: "bg-slate-900 text-white p-8 my-10 rounded-[2.5rem] shadow-2xl relative overflow-hidden group") do
          concat(content_tag(:div, class: "absolute -right-4 -bottom-4 opacity-10 group-hover:scale-110 transition-transform") { content_tag(:i, "", class: "fas fa-fish text-8xl") })
          concat(content_tag(:div, class: "relative z-10") do
            concat(content_tag(:div, class: "flex items-center gap-3 mb-4") do
              concat(content_tag(:div, class: "w-8 h-8 rounded-full bg-[#f9a825] flex items-center justify-center text-slate-900") { content_tag(:i, "", class: "fas fa-anchor text-xs") })
              concat(content_tag(:span, "The Hook", class: "text-[#f9a825] font-black uppercase tracking-[0.3em] text-xs"))
            end)
            concat(content_tag(:div, simple_format(content), class: "text-white font-bold text-xl leading-relaxed [&>p]:m-0"))
          end)
        end
      elsif lines.length > 2 && lines.any? { |l| l.include?("|") }
        # Table detection (require at least 3 lines to be a table)
        content_tag(:div, class: "overflow-x-auto my-10 rounded-2xl border border-slate-200 shadow-sm") do
          content_tag(:table, class: "table table-zebra w-full") do
            header_rendered = false
            lines.map.with_index do |line, i|
              cells = line.split("|").map(&:strip)
              next if cells.all?(&:blank?)
              
              if !header_rendered
                header_rendered = true
                content_tag(:thead, class: "bg-slate-100") do
                  content_tag(:tr) do
                    cells.map { |cell| content_tag(:th, cell, class: "text-slate-900 font-black uppercase tracking-widest text-[10px] py-4") }.join.html_safe
                  end
                end
              else
                content_tag(:tr) do
                  cells.map { |cell| content_tag(:td, cell, class: "py-4 text-slate-700") }.join.html_safe
                end
              end
            end.join.html_safe
          end
        end
      elsif lines.length > 1 && lines[1..].any? { |l| l.strip.match?(/^[*\-•]/) }
          content_tag(:div, class: "space-y-4 my-6") do
            lines.each_with_index do |line, i|
              if i == 0
                concat(content_tag(:h4, class: "#{primary_text} font-black uppercase tracking-widest text-xs mb-4 flex items-center gap-3 group/header") do
                  concat(content_tag(:span, "", class: "w-8 h-[2px] bg-[#f9a825] group-hover/header:w-12 transition-all"))
                  concat(line.strip)
                end)
              else
                clean_line = line.strip.gsub(/^[*\-•]\s*/, "")
                concat(content_tag(:div, class: "flex items-start gap-3 ml-11") do
                  concat(content_tag(:div, class: "w-5 h-5 rounded-full bg-[#f9a825]/20 flex items-center justify-center flex-shrink-0 mt-1") { content_tag(:i, "", class: "fas fa-chevron-right text-[8px] text-[#f9a825]") })
                  concat(content_tag(:p, clean_line, class: "#{secondary_text} m-0 text-lg"))
                end)
              end
            end
          end
        elsif lines.length > 1 && lines[1..].any? { |l| l.include?(":") && l.split(":").first.length < 40 }
          # Detection for "Definition Lists" (Term: Definition)
          content_tag(:div, class: "space-y-6 my-10") do
            lines.each_with_index do |line, i|
              if i == 0
                concat(content_tag(:h4, class: "#{primary_text} font-black uppercase tracking-widest text-xs mb-6 flex items-center gap-3 group/header") do
                  concat(content_tag(:span, "", class: "w-8 h-[2px] bg-[#f9a825] group-hover/header:w-12 transition-all"))
                  concat(line.strip)
                end)
              else
                next if line.blank?
                if line.include?(":")
                  parts = line.split(":", 2)
                  term = parts[0].strip
                  definition = parts[1].strip
                  card_bg = options[:dark_mode] ? "bg-white/5 border-white/10" : "bg-white border-slate-100"
                  concat(content_tag(:div, class: "ml-11 #{card_bg} border rounded-2xl p-6 shadow-sm hover:shadow-md hover:border-[#f9a825]/30 transition-all group/term") do
                    concat(content_tag(:div, class: "flex flex-col md:flex-row md:items-start gap-4") do
                      concat(content_tag(:div, term, class: "bg-slate-900 text-[#f9a825] px-4 py-2 rounded-xl font-black text-sm uppercase tracking-tighter shadow-lg flex-shrink-0 text-center min-w-[120px]"))
                      concat(content_tag(:div, definition, class: "#{secondary_text} leading-relaxed font-medium"))
                    end)
                  end)
                else
                  concat(content_tag(:p, line.strip, class: "ml-11 #{muted_text} italic text-sm"))
                end
              end
            end
          end
        else
          # Detect inline headings (lines ending in colon)
          lines = temp_block.split("\n").reject(&:blank?)
          if lines.any? && lines.first.strip.match?(/^[A-Z].*:$/) && lines.first.strip.length < 60
            heading = lines.first.strip
            remaining_content = lines[1..].join("\n")
            
            content_tag(:div, class: "my-8") do
              concat(content_tag(:h4, class: "#{primary_text} font-black uppercase tracking-widest text-xs mb-4 flex items-center gap-3 group/header") do
                concat(content_tag(:span, "", class: "w-8 h-[2px] bg-[#f9a825] group-hover/header:w-12 transition-all"))
                concat(heading)
              end)
              concat(content_tag(:div, simple_format(remaining_content), class: "#{secondary_text} ml-11")) if remaining_content.present?
            end
          else
            simple_format(temp_block)
          end
        end

        (media_html + block_html).html_safe
      end.join("\n").html_safe
  end

  def render_videos(url_text)
    return if url_text.blank?
    
    # Split by whitespace or newlines
    urls = url_text.split(/\s+/).reject(&:blank?)
    
    urls.map do |video_url|
      video_src = video_url
      if video_src.include?("youtube.com/watch?v=")
        video_src = video_src.gsub("youtube.com/watch?v=", "youtube.com/embed/")
      elsif video_src.include?("youtu.be/")
        video_src = video_src.gsub("youtu.be/", "youtube.com/embed/")
      end

      content_tag(:div, class: "mb-8 aspect-video bg-slate-900 rounded-[2.5rem] overflow-hidden shadow-2xl border-4 border-slate-900") do
        content_tag(:iframe, "", 
          src: video_src, 
          class: "w-full h-full",
          frameborder: "0", 
          allow: "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share", 
          referrerpolicy: "strict-origin-when-cross-origin", 
          allowfullscreen: true)
      end
    end.join("\n").html_safe
  end
%>

<div class="space-y-24">
  <!-- Header / Bio -->
  <% if civic_topic.bio.present? %>
    <% 
      bio_text = civic_topic.bio
      citation = nil
      if bio_text.include?("Work Cited:")
        parts = bio_text.split("Work Cited:", 2)
        bio_text = parts[0]
        citation = parts[1]
      end
    %>
    <div class="mb-16">
      <div class="flex items-center gap-2 mb-2">
        <span class="w-6 h-[1px] bg-slate-300"></span>
        <span class="text-slate-400 text-[10px] font-black uppercase tracking-[0.4em]">Introduction</span>
      </div>
      <h2 class="text-4xl font-black text-slate-900 mb-8 border-b-8 border-[#f9a825] pb-4 inline-block tracking-tighter">
        <%= civic_topic.bio_heading.presence || 'Lesson Overview' %>
      </h2>
      <div class="text-slate-600 leading-relaxed text-xl font-medium">
        <%= render_lesson_content(bio_text, civic_topic) %>
      </div>

      <% if citation.present? %>
        <div class="mt-12 pt-8 border-t border-slate-100">
          <div class="flex items-start gap-4 p-8 bg-slate-50 rounded-3xl border border-slate-100 shadow-sm relative overflow-hidden group">
            <div class="absolute top-0 right-0 p-4 opacity-5 group-hover:opacity-10 transition-opacity">
              <i class="fas fa-quote-right text-6xl text-slate-900"></i>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-white border border-slate-200 flex items-center justify-center flex-shrink-0 shadow-sm">
              <i class="fas fa-bookmark text-[#f9a825]"></i>
            </div>
            <div>
              <h4 class="text-xs uppercase tracking-[0.2em] text-slate-400 font-bold mb-3 flex items-center gap-2">
                Work Cited
              </h4>
              <div class="text-slate-500 italic font-serif text-lg leading-relaxed m-0 [&>p]:mb-4 last:[&>p]:mb-0">
                <%= simple_format citation.strip %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <% if pdf_block_html.present? %>
        <%= pdf_block_html %>
      <% end %>
    </div>
  <% end %>

  <!-- Master Slide Deck -->
  <% if master_slides_html.present? %>
    <div class="my-20">
      <div class="flex items-center gap-2 mb-2">
        <span class="w-6 h-[1px] bg-[#f9a825]"></span>
        <span class="text-[#f9a825] text-[10px] font-black uppercase tracking-[0.4em]">Visual Presentation</span>
      </div>
      <h2 class="text-4xl font-black text-slate-900 mb-8 border-b-8 border-slate-900 pb-4 inline-block tracking-tighter">
        Lesson Slide Deck
      </h2>
      <%= master_slides_html %>
    </div>
  <% end %>

  <!-- Standards Alignment -->
  <% if civic_topic.contributions.present? %>
    <div class="bg-slate-50 rounded-[3rem] p-10 md:p-16 border border-slate-100 shadow-sm relative overflow-hidden">
      <div class="absolute top-0 right-0 p-12 opacity-[0.03] pointer-events-none">
        <i class="fas fa-certificate text-[12rem] text-slate-900"></i>
      </div>
      <div class="relative z-10">
        <h3 class="text-3xl font-black text-slate-900 mb-10 flex items-center gap-4 uppercase tracking-tight">
          <i class="fas fa-check-double text-[#f9a825]"></i>
          Utah State Standards Alignment
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <% civic_topic.contributions.split("\n").reject(&:blank?).each do |standard| %>
            <div class="flex items-start gap-4 group">
              <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center flex-shrink-0 shadow-sm group-hover:border-[#f9a825] transition-colors mt-0.5">
                <i class="fas fa-bookmark text-[#f9a825]"></i>
              </div>
              <div class="pt-1">
                <% if standard.include?(":") %>
                  <% parts = standard.split(":", 2) %>
                  <strong class="text-slate-900 font-bold block mb-1 text-lg"><%= parts[0].strip %></strong>
                  <span class="text-slate-600"><%= parts[1].strip %></span>
                <% else %>
                  <span class="text-slate-700 font-medium text-lg"><%= standard %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Video Section (if at top) -->
  <% if civic_topic.video_url.present? %>
    <div class="my-16">
      <h2 class="text-2xl font-bold text-slate-900 mb-8 flex items-center gap-3">
        <i class="fas fa-play-circle text-[#f9a825]"></i>
        Lesson Videos
      </h2>
      <%= render_videos(civic_topic.video_url) %>
    </div>
  <% end %>

  <!-- PART 1 -->
  <% if civic_topic.legacy.present? %>
    <div class="relative group pt-24 pb-24 px-12 -mx-12 rounded-[4rem] hover:bg-slate-50/80 transition-all duration-700">
      <!-- Background Number -->
      <div class="absolute -top-16 -left-16 text-[25rem] font-black text-slate-100/50 phase-number pointer-events-none select-none group-hover:text-[#f9a825]/5 transition-colors duration-700 leading-none z-0">1</div>
      
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-24 relative z-10">
        <div class="lg:w-1/3">
          <div class="sticky top-24">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-1 px-0 bg-[#f9a825]"></div>
              <span class="text-[#f9a825] text-[12px] font-black uppercase tracking-[0.5em]">Phase 01</span>
            </div>
            <h3 class="text-5xl lg:text-7xl font-black text-slate-900 uppercase tracking-tighter leading-[0.9] mb-8">
              <%= civic_topic.legacy_heading.presence || "Phase 01" %>
            </h3>
            <div class="w-20 h-2 bg-slate-900 mb-8 rounded-full"></div>
          </div>
        </div>
        <div class="lg:w-2/3 border-l-[12px] border-[#f9a825]/10 pl-8 lg:pl-16 py-4 group-hover:border-[#f9a825] transition-all duration-500">
          <div class="prose prose-slate prose-2xl max-w-none text-slate-600 leading-relaxed font-medium [&>p]:mb-8 last:[&>p]:mb-0">
            <%= render_lesson_content(civic_topic.legacy, civic_topic) %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- PART 2 -->
  <% if civic_topic.main_ideas.present? %>
    <div class="relative group pt-24 pb-24 px-12 -mx-12 rounded-[4rem] hover:bg-slate-50/80 transition-all duration-700">
      <!-- Background Number -->
      <div class="absolute -top-16 -left-16 text-[25rem] font-black text-slate-100/50 phase-number pointer-events-none select-none group-hover:text-[#f9a825]/5 transition-colors duration-700 leading-none z-0">2</div>
      
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-24 relative z-10">
        <div class="lg:w-1/3">
          <div class="sticky top-24">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-1 px-0 bg-[#f9a825]"></div>
              <span class="text-[#f9a825] text-[12px] font-black uppercase tracking-[0.5em]">Phase 02</span>
            </div>
            <h3 class="text-5xl lg:text-7xl font-black text-slate-900 uppercase tracking-tighter leading-[0.9] mb-8">
              <%= civic_topic.main_ideas_heading.presence || "Phase 02" %>
            </h3>
            <div class="w-20 h-2 bg-slate-900 mb-8 rounded-full"></div>
          </div>
        </div>
        <div class="lg:w-2/3 border-l-[12px] border-[#f9a825]/10 pl-8 lg:pl-16 py-4 group-hover:border-[#f9a825] transition-all duration-500">
          <div class="prose prose-slate prose-2xl max-w-none text-slate-600 leading-relaxed font-medium [&>p]:mb-8 last:[&>p]:mb-0">
            <%= render_lesson_content(civic_topic.main_ideas, civic_topic) %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- PART 3 -->
  <% if civic_topic.criticism.present? %>
    <div class="relative group pt-24 pb-24 px-12 -mx-12 rounded-[4rem] hover:bg-slate-50/80 transition-all duration-700">
      <!-- Background Number -->
      <div class="absolute -top-16 -left-16 text-[25rem] font-black text-slate-100/50 phase-number pointer-events-none select-none group-hover:text-[#f9a825]/5 transition-colors duration-700 leading-none z-0">3</div>
      
      <div class="flex flex-col lg:flex-row gap-12 lg:gap-24 relative z-10">
        <div class="lg:w-1/3">
          <div class="sticky top-24">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-1 px-0 bg-[#f9a825]"></div>
              <span class="text-[#f9a825] text-[12px] font-black uppercase tracking-[0.5em]">Phase 03</span>
            </div>
            <h3 class="text-5xl lg:text-7xl font-black text-slate-900 uppercase tracking-tighter leading-[0.9] mb-8">
              <%= civic_topic.criticism_heading.presence || "Phase 03" %>
            </h3>
            <div class="w-20 h-2 bg-slate-900 mb-8 rounded-full"></div>
          </div>
        </div>
        <div class="lg:w-2/3 border-l-[12px] border-[#f9a825]/10 pl-8 lg:pl-16 py-4 group-hover:border-[#f9a825] transition-all duration-500">
          <div class="prose prose-slate prose-2xl max-w-none text-slate-600 leading-relaxed font-medium [&>p]:mb-8 last:[&>p]:mb-0">
            <%= render_lesson_content(civic_topic.criticism, civic_topic) %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Exit Ticket -->
  <% if civic_topic.suggested_reading.present? %>
    <div class="mt-32 bg-slate-900 rounded-[4rem] p-12 md:p-24 border-t-[12px] border-[#f9a825] shadow-[0_50px_100px_rgba(0,0,0,0.4)] relative overflow-hidden group/exit">
      <div class="absolute top-0 right-0 p-12 opacity-10 group-hover/exit:scale-125 transition-transform duration-1000">
        <i class="fas fa-door-open text-[15rem] text-white"></i>
      </div>
      <div class="relative z-10">
        <div class="flex items-center gap-6 mb-12">
          <div class="w-16 h-16 rounded-3xl bg-[#f9a825] flex items-center justify-center text-slate-900 shadow-[0_15px_30px_rgba(249,168,37,0.4)] group-hover/exit:rotate-12 transition-transform">
            <i class="fas fa-ticket-alt text-2xl"></i>
          </div>
          <div>
            <span class="text-[#f9a825] font-black uppercase tracking-[0.4em] text-xs block mb-1">Lesson Finale</span>
            <h2 class="text-5xl md:text-7xl font-black text-white tracking-tighter leading-none">
              <%= civic_topic.id == 17 ? 'Conclusion' : 'Exit Ticket' %>
            </h2>
          </div>
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12">
          <% civic_topic.suggested_reading.to_s.split("\n\n").each do |block| %>
            <%# Pre-filter: if after removing Image/Video tags the block is empty, skip it %>
            <% clean_block = block.gsub(/(?:Image|Video):\s*[^\n]+\n?/i, "").strip %>
            <% next if clean_block.blank? %>

            <% rendered_block = render_lesson_content(block, civic_topic, dark_mode: true) %>
            <% next if rendered_block.blank? || strip_tags(rendered_block).strip.blank? %>
            
            <div class="bg-white/5 border border-white/10 p-10 rounded-[3rem] hover:bg-white/10 transition-all duration-500 hover:-translate-y-2 group/card">
              <div class="flex items-start gap-6">
                <div class="w-10 h-10 rounded-full bg-[#f9a825]/20 flex items-center justify-center flex-shrink-0 group-hover/card:bg-[#f9a825] group-hover/card:text-slate-900 transition-colors">
                  <i class="fas fa-question text-sm"></i>
                </div>
                <div class="text-white leading-relaxed text-2xl md:text-3xl font-bold italic tracking-tight">
                  <%= rendered_block %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% if civic_topic.id == 17 %>
    <div class="flex justify-center opacity-5 pointer-events-none select-none my-12">
      <div class="border-4 border-slate-900 text-slate-900 font-mono text-4xl font-black px-6 py-2 uppercase -rotate-6">
        Declassified
      </div>
    </div>
  <% end %>

  <!-- Teacher Resources Footer -->
  <% if civic_topic.handout_pdf.attached? %>
    <div class="mt-20 bg-slate-50 rounded-[2rem] p-8 md:p-12 border border-slate-200 flex flex-col md:flex-row items-center gap-8">
      <div class="w-16 h-16 rounded-2xl bg-[#f9a825] flex items-center justify-center text-slate-900 shadow-lg flex-shrink-0">
        <i class="fas fa-file-download text-2xl"></i>
      </div>
      <div class="flex-grow text-center md:text-left">
        <h3 class="text-xl font-bold text-slate-900 mb-1">Download Teacher Resources</h3>
        <p class="text-slate-500 mb-0">Get the full PDF lesson plan, student handouts, and teacher guides.</p>
      </div>
      <%= link_to url_for(civic_topic.handout_pdf), class: "btn btn-primary bg-[#f9a825] border-none text-slate-900 hover:bg-slate-900 hover:text-white gap-2 px-8 rounded-xl font-bold shadow-lg transition-all", target: "_blank" do %>
        <i class="fas fa-download"></i>
        Download Materials
      <% end %>
    </div>
  <% end %>
</div>