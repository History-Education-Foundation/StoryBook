<%# app/views/civic_topics/_lesson_plan_detail.html.erb %>
<%# Expected local: civic_topic %>

<%
  def render_lesson_content(text, civic_topic = nil, options = {})
    return "" if text.blank?
    
    # Text color defaults based on dark mode option
    primary_text = options[:dark_mode] ? "text-white" : "text-slate-900"
    secondary_text = options[:dark_mode] ? "text-white/70" : "text-slate-700"
    muted_text = options[:dark_mode] ? "text-white/40" : "text-slate-500"
    
    # Split by double newline to get blocks
    blocks = text.split("\n\n")
    
    # PDF logic for IDs 9 and 40
    show_pdf = [9, 40].include?(civic_topic&.id) || civic_topic&.handout_pdf&.attached?
    pdf_rendered = false

    html = blocks.map do |block|
      # Extract and render media first (Images and Videos)
      media_html = ""
      temp_block = block.dup
      
      # Match Image: or Video: followed by a URL/filename
      media_matches = temp_block.scan(/(?:Image|Video):\s*([^\n]+)/i)
      if media_matches.any?
        content_urls = media_matches.flatten.map(&:strip)
        images = content_urls.select { |url| url.match?(/\.(jpg|jpeg|png|gif|webp|avif)/i) }
        videos = content_urls.reject { |url| url.match?(/\.(jpg|jpeg|png|gif|webp|avif)/i) }
        
        if images.any?
          grid_class = images.length > 1 ? "grid grid-cols-1 md:grid-cols-#{[images.length, 3].min} gap-4 my-10" : "my-10"
          media_html += content_tag(:div, class: grid_class) do
            images.map do |img_url|
              content_tag(:div, class: "rounded-[2rem] overflow-hidden shadow-2xl border border-slate-100 bg-slate-50 p-2 group/img relative") do
                concat(image_tag(img_url, class: "w-full h-48 md:h-64 object-cover rounded-xl group-hover/img:scale-105 transition-transform duration-700", alt: "Lesson Illustration"))
                concat(content_tag(:div, class: "mt-2 flex items-center gap-2 text-slate-400 text-[10px] font-bold uppercase tracking-widest px-2") do
                  concat(content_tag(:i, "", class: "fas fa-image"))
                  concat("View Illustration")
                end)
              end
            end.join.html_safe
          end
        end
        
        if videos.any?
          media_html += videos.map do |video_url|
            video_src = video_url
            if video_src.include?("youtube.com/watch?v=")
              video_src = video_src.gsub("youtube.com/watch?v=", "youtube.com/embed/")
            elsif video_src.include?("youtu.be/")
              video_src = video_src.gsub("youtu.be/", "youtube.com/embed/")
            end

            content_tag(:div, class: "my-10 aspect-video bg-slate-900 rounded-[2.5rem] overflow-hidden shadow-2xl border border-white/10 group/video relative") do
              content_tag(:iframe, "", 
                src: video_src, 
                class: "w-full h-full relative z-10",
                frameborder: "0", 
                allow: "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share", 
                referrerpolicy: "strict-origin-when-cross-origin", 
                allowfullscreen: true)
            end
          end.join
        end
        
        # Remove media lines from the block so they don't get rendered as text
        temp_block = temp_block.gsub(/(?:Image|Video):\s*[^\n]+\n?/i, "").strip
      end

      # PDF insertion for lobbying lesson plans
      pdf_html = ""
      if show_pdf && !pdf_rendered && (temp_block.match?(/Activity:/i) || temp_block.match?(/Mini-Lesson:/i))
        pdf_rendered = true
        pdf_html = content_tag(:div, class: "my-12 bg-white border border-slate-200 rounded-[2rem] p-8 shadow-sm flex items-center gap-6 group hover:border-[#f9a825] transition-colors") do
          concat(content_tag(:div, class: "w-16 h-16 rounded-2xl bg-[#f9a825]/10 flex items-center justify-center text-[#f9a825] group-hover:bg-[#f9a825] group-hover:text-slate-900 transition-colors") { content_tag(:i, "", class: "fas fa-file-pdf text-2xl") })
          concat(content_tag(:div, class: "flex-grow") do
            concat(content_tag(:h4, "Lesson Handout Available", class: "text-slate-900 font-bold text-lg mb-1"))
            concat(content_tag(:p, "Download the student activity sheet for this section.", class: "text-slate-500 text-sm mb-0"))
          end)
          concat(link_to(url_for(civic_topic.handout_pdf), class: "btn btn-circle bg-slate-900 border-none text-white hover:bg-[#f9a825] hover:text-slate-900 shadow-lg", target: "_blank") { content_tag(:i, "", class: "fas fa-arrow-down") })
        end
      end

      block_html = if temp_block.match?(/Mini-Lesson:/i)
        content = temp_block.gsub(/Mini-Lesson:/i, "").strip
        content_tag(:div, class: "bg-[#f9a825]/10 border-l-4 border-[#f9a825] p-6 my-8 rounded-r-2xl shadow-sm") do
          concat(content_tag(:div, class: "flex items-center gap-3 mb-2") do
            concat(content_tag(:div, class: "w-8 h-8 rounded-full bg-[#f9a825] flex items-center justify-center text-slate-900 shadow-md") { content_tag(:i, "", class: "fas fa-chalkboard-teacher text-xs") })
            concat(content_tag(:span, "Mini-Lesson", class: "text-[#f9a825] font-black uppercase tracking-[0.2em] text-xs"))
          end)
          concat(content_tag(:div, simple_format(content), class: "text-slate-800 font-bold text-xl [&>p]:m-0"))
        end
      elsif temp_block.match?(/Activity:/i)
        content = temp_block.gsub(/Activity:/i, "").strip
        content_tag(:div, class: "bg-slate-900 border-l-4 border-[#f9a825] p-8 my-10 rounded-r-[2rem] shadow-xl relative overflow-hidden group") do
          concat(content_tag(:div, class: "absolute top-0 right-0 p-8 opacity-10 group-hover:scale-110 transition-transform") { content_tag(:i, "", class: "fas fa-running text-6xl text-white") })
          concat(content_tag(:div, class: "relative z-10") do
            concat(content_tag(:div, class: "flex items-center gap-3 mb-4") do
              concat(content_tag(:div, class: "w-10 h-10 rounded-full bg-[#f9a825] flex items-center justify-center text-slate-900 shadow-lg") { content_tag(:i, "", class: "fas fa-users text-sm") })
              concat(content_tag(:span, "Student Activity", class: "text-[#f9a825] font-black uppercase tracking-[0.3em] text-xs"))
            end)
            concat(content_tag(:div, simple_format(content), class: "text-white font-bold text-2xl leading-relaxed [&>p]:m-0"))
          end)
        end
      elsif temp_block.match?(/Discussion:/i)
        content = temp_block.gsub(/Discussion:/i, "").strip
        content_tag(:div, class: "bg-slate-50 border-l-4 border-slate-300 p-6 my-8 rounded-r-2xl shadow-sm") do
          concat(content_tag(:div, class: "flex items-center gap-3 mb-2") do
            concat(content_tag(:div, class: "w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center text-slate-600") { content_tag(:i, "", class: "fas fa-comments text-xs") })
            concat(content_tag(:span, "Discussion Question", class: "text-slate-500 font-black uppercase tracking-[0.2em] text-xs"))
          end)
          concat(content_tag(:div, simple_format(content), class: "text-slate-700 font-medium text-lg italic [&>p]:m-0"))
        end
      elsif temp_block.match?(/Point:|Goal:|Core Tip:/i)
        # Style important callouts within sections
        marker = temp_block.match(/Point:|Goal:|Core Tip:/i)[0]
        content = temp_block.gsub(/#{marker}/i, "").strip
        bg_class = options[:dark_mode] ? "bg-white/5 border-white/10" : "bg-[#f9a825]/5 border-[#f9a825]/20"
        content_tag(:div, class: "#{bg_class} border p-6 my-6 rounded-2xl flex items-start gap-4") do
          concat(content_tag(:div, class: "w-10 h-10 rounded-lg bg-[#f9a825] flex items-center justify-center text-slate-900 shadow-sm flex-shrink-0 mt-1") do
            content_tag(:i, "", class: "fas fa-star text-sm")
          end)
          concat(content_tag(:div) do
            concat(content_tag(:span, marker.gsub(":", ""), class: "text-[#f9a825] font-black uppercase tracking-widest text-[10px] block mb-1"))
            concat(content_tag(:div, simple_format(content), class: "#{primary_text} font-bold text-lg leading-snug [&>p]:m-0"))
          end)
        end
      elsif temp_block.match?(/Essential Question:/i)
        content = temp_block.gsub(/Essential Question:/i, "").strip
        content_tag(:div, class: "bg-[#f9a825] text-slate-900 p-8 my-10 rounded-[2.5rem] shadow-xl relative overflow-hidden group") do
          concat(content_tag(:div, class: "absolute -right-4 -top-4 opacity-10 group-hover:scale-110 transition-transform") { content_tag(:i, "", class: "fas fa-question-circle text-[10rem]") })
          concat(content_tag(:div, class: "relative z-10") do
            concat(content_tag(:div, class: "flex items-center gap-3 mb-4") do
              concat(content_tag(:div, class: "w-8 h-8 rounded-full bg-slate-900 flex items-center justify-center text-[#f9a825]") { content_tag(:i, "", class: "fas fa-lightbulb text-xs") })
              concat(content_tag(:span, "Essential Question", class: "text-slate-900 font-black uppercase tracking-[0.3em] text-xs"))
            end)
            concat(content_tag(:h2, content, class: "text-slate-900 font-black text-3xl leading-tight italic tracking-tighter"))
          end)
        end
      elsif temp_block.match?(/Hook:/i)
        content = temp_block.gsub(/Hook:/i, "").strip
        content_tag(:div, class: "bg-slate-900 text-white p-8 my-10 rounded-[2.5rem] shadow-2xl relative overflow-hidden group") do
          concat(content_tag(:div, class: "absolute -right-4 -bottom-4 opacity-10 group-hover:scale-110 transition-transform") { content_tag(:i, "", class: "fas fa-fish text-8xl") })
          concat(content_tag(:div, class: "relative z-10") do
            concat(content_tag(:div, class: "flex items-center gap-3 mb-4") do
              concat(content_tag(:div, class: "w-8 h-8 rounded-full bg-[#f9a825] flex items-center justify-center text-slate-900") { content_tag(:i, "", class: "fas fa-anchor text-xs") })
              concat(content_tag(:span, "The Hook", class: "text-[#f9a825] font-black uppercase tracking-[0.3em] text-xs"))
            end)
            concat(content_tag(:div, simple_format(content), class: "text-white font-bold text-xl leading-relaxed [&>p]:m-0"))
          end)
        end
      else
        # Enhanced list detection for simple text blocks
        lines = temp_block.split("\n")
        if lines.length > 2 && lines.any? { |l| l.include?("|") }
          # Table detection (require at least 3 lines to be a table)
          content_tag(:div, class: "overflow-x-auto my-10 rounded-2xl border border-slate-200 shadow-sm") do
            content_tag(:table, class: "table table-zebra w-full") do
              header_rendered = false
              lines.map.with_index do |line, i|
                cells = line.split("|").map(&:strip)
                next if cells.all?(&:blank?)
                
                if !header_rendered
                  header_rendered = true
                  content_tag(:thead, class: "bg-slate-100") do
                    content_tag(:tr) do
                      cells.map { |cell| content_tag(:th, cell, class: "text-slate-900 font-black uppercase tracking-widest text-[10px] py-4") }.join.html_safe
                    end
                  end
                else
                  content_tag(:tr) do
                    cells.map { |cell| content_tag(:td, cell, class: "text-slate-700 font-medium py-4") }.join.html_safe
                  end
                end
              end.join.html_safe
            end
          end
        elsif lines.length > 1 && lines[1..].any? { |l| l.strip.match?(/^[*\-•]/) }
          content_tag(:div, class: "space-y-4 my-6") do
            lines.each_with_index do |line, i|
              if i == 0
                concat(content_tag(:h4, class: "#{primary_text} font-black uppercase tracking-widest text-xs mb-4 flex items-center gap-3 group/header") do
                  concat(content_tag(:span, "", class: "w-8 h-[2px] bg-[#f9a825] group-hover/header:w-12 transition-all"))
                  concat(line.strip)
                end)
              else
                clean_line = line.strip.gsub(/^[*\-•]\s*/, "")
                concat(content_tag(:div, class: "flex items-start gap-3 ml-11") do
                  concat(content_tag(:div, class: "w-5 h-5 rounded-full bg-[#f9a825]/20 flex items-center justify-center flex-shrink-0 mt-1") { content_tag(:i, "", class: "fas fa-chevron-right text-[8px] text-[#f9a825]") })
                  concat(content_tag(:p, clean_line, class: "#{secondary_text} m-0 text-lg"))
                end)
              end
            end
          end
        elsif lines.length > 1 && lines[1..].any? { |l| l.include?(":") && l.split(":").first.length < 40 }
          # Detection for "Definition Lists" (Term: Definition)
          content_tag(:div, class: "space-y-6 my-10") do
            lines.each_with_index do |line, i|
              if i == 0
                concat(content_tag(:h4, class: "#{primary_text} font-black uppercase tracking-widest text-xs mb-6 flex items-center gap-3 group/header") do
                  concat(content_tag(:span, "", class: "w-8 h-[2px] bg-[#f9a825] group-hover/header:w-12 transition-all"))
                  concat(line.strip)
                end)
              else
                next if line.blank?
                if line.include?(":")
                  parts = line.split(":", 2)
                  term = parts[0].strip
                  definition = parts[1].strip
                  card_bg = options[:dark_mode] ? "bg-white/5 border-white/10" : "bg-white border-slate-100"
                  concat(content_tag(:div, class: "ml-11 #{card_bg} border rounded-2xl p-6 shadow-sm hover:shadow-md hover:border-[#f9a825]/30 transition-all group/term") do
                    concat(content_tag(:div, class: "flex flex-col md:flex-row md:items-start gap-4") do
                      concat(content_tag(:div, term, class: "bg-slate-900 text-[#f9a825] px-4 py-2 rounded-xl font-black text-sm uppercase tracking-tighter shadow-lg flex-shrink-0 text-center min-w-[120px]"))
                      concat(content_tag(:div, definition, class: "#{secondary_text} leading-relaxed font-medium"))
                    end)
                  end)
                else
                  concat(content_tag(:p, line.strip, class: "ml-11 #{muted_text} italic text-sm"))
                end
              end
            end
          end
        else
          # Detect inline headings (lines ending in colon)
          lines = temp_block.split("\n").reject(&:blank?)
          if lines.any? && lines.first.strip.match?(/^[A-Z].*:$/) && lines.first.strip.length < 60
            heading = lines.first.strip
            remaining_content = lines[1..].join("\n")
            
            content_tag(:div, class: "my-8") do
              concat(content_tag(:h4, class: "#{primary_text} font-black uppercase tracking-widest text-xs mb-4 flex items-center gap-3 group/header") do
                concat(content_tag(:span, "", class: "w-8 h-[2px] bg-[#f9a825] group-hover/header:w-12 transition-all"))
                concat(heading)
              end)
              concat(content_tag(:div, simple_format(remaining_content), class: "#{secondary_text} ml-11")) if remaining_content.present?
            end
          else
            simple_format(temp_block)
          end
        end
      end

      pdf_html + media_html + block_html
    end.join("\n").html_safe
  end

  def render_videos(url_text)
    return if url_text.blank?
    
    # Split by whitespace or newlines
    urls = url_text.split(/\s+/).reject(&:blank?)
    
    urls.map do |video_url|
      video_src = video_url
      if video_src.include?("youtube.com/watch?v=")
        video_src = video_src.gsub("youtube.com/watch?v=", "youtube.com/embed/")
      elsif video_src.include?("youtu.be/")
        video_src = video_src.gsub("youtu.be/", "youtube.com/embed/")
      end

      content_tag(:div, class: "mb-8 aspect-video bg-slate-900 rounded-[2.5rem] overflow-hidden shadow-2xl border border-slate-100") do
        content_tag(:iframe, "", 
          src: video_src, 
          class: "w-full h-full",
          frameborder: "0", 
          allow: "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share", 
          referrerpolicy: "strict-origin-when-cross-origin", 
          allowfullscreen: true)
      end
    end.join("\n").html_safe
  end
%>

<div class="space-y-24">
  <!-- Header / Bio -->
  <% if civic_topic.bio.present? %>
    <div class="mb-16">
      <div class="flex items-center gap-2 mb-2">
        <span class="w-6 h-[1px] bg-slate-300"></span>
        <span class="text-slate-400 text-[10px] font-black uppercase tracking-[0.4em]">Introduction</span>
      </div>
      <h2 class="text-4xl font-black text-slate-900 mb-8 border-b-8 border-[#f9a825] pb-4 inline-block tracking-tighter">
        <%= civic_topic.bio_heading.presence || 'Lesson Overview' %>
      </h2>
      <div class="text-slate-600 leading-relaxed text-xl">
        <%= render_lesson_content(civic_topic.bio, civic_topic) %>
      </div>
    </div>
  <% end %>

  <!-- Standards Alignment -->
  <% if civic_topic.contributions.present? %>
    <div class="bg-slate-50 rounded-[3rem] p-10 md:p-16 border border-slate-100 shadow-sm relative overflow-hidden">
      <div class="absolute top-0 right-0 p-12 opacity-[0.03] pointer-events-none">
        <i class="fas fa-certificate text-[12rem] text-slate-900"></i>
      </div>
      <div class="relative z-10">
        <h3 class="text-3xl font-black text-slate-900 mb-10 flex items-center gap-4 uppercase tracking-tight">
          <i class="fas fa-check-double text-[#f9a825]"></i>
          Utah State Standards Alignment
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <% civic_topic.contributions.split("\n").reject(&:blank?).each do |standard| %>
            <div class="flex items-start gap-4 group">
              <div class="w-10 h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center flex-shrink-0 shadow-sm group-hover:border-[#f9a825] transition-colors mt-0.5">
                <i class="fas fa-bookmark text-[#f9a825]"></i>
              </div>
              <div class="pt-1">
                <% if standard.include?(":") %>
                  <% parts = standard.split(":", 2) %>
                  <strong class="text-slate-900 font-bold block mb-1 text-lg"><%= parts[0].strip %></strong>
                  <span class="text-slate-600"><%= parts[1].strip %></span>
                <% else %>
                  <span class="text-slate-700 font-medium text-lg"><%= standard %></span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Video Section (if at top) -->
  <% if civic_topic.video_url.present? %>
    <div class="my-16">
      <h2 class="text-2xl font-bold text-slate-900 mb-8 flex items-center gap-3">
        <i class="fas fa-play-circle text-[#f9a825]"></i>
        Lesson Videos
      </h2>
      <%= render_videos(civic_topic.video_url) %>
    </div>
  <% end %>

  <!-- PART 1 -->
  <% if civic_topic.legacy.present? %>
    <div class="relative group pt-16 pb-16 px-10 -mx-10 rounded-[3rem] hover:bg-slate-50/50 transition-colors duration-500">
      <!-- Background Number -->
      <div class="absolute -top-10 -left-10 text-[15rem] font-black text-slate-100 pointer-events-none select-none opacity-50 group-hover:text-[#f9a825]/10 transition-colors duration-700 leading-none">1</div>
      
      <div class="flex flex-col md:flex-row gap-8 md:gap-16 relative z-10">
        <div class="md:w-1/4">
          <div class="sticky top-10">
            <div class="flex items-center gap-2 mb-4">
              <span class="w-8 h-[2px] bg-[#f9a825]"></span>
              <span class="text-[#f9a825] text-[10px] font-black uppercase tracking-[0.4em]">Phase 01</span>
            </div>
            <h3 class="text-4xl font-black text-slate-900 uppercase tracking-tighter leading-tight">
              <%= civic_topic.legacy_heading.presence || "Taxes" %>
            </h3>
          </div>
        </div>
        <div class="md:w-3/4 border-l-8 border-[#f9a825] pl-8 md:pl-12 py-2">
          <div class="prose prose-slate prose-xl max-w-none text-slate-600 leading-relaxed">
            <%= render_lesson_content(civic_topic.legacy, civic_topic) %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- PART 2 -->
  <% if civic_topic.main_ideas.present? %>
    <div class="relative group pt-16 pb-16 px-10 -mx-10 rounded-[3rem] hover:bg-slate-50/50 transition-colors duration-500">
      <!-- Background Number -->
      <div class="absolute -top-10 -left-10 text-[15rem] font-black text-slate-100 pointer-events-none select-none opacity-50 group-hover:text-[#f9a825]/10 transition-colors duration-700 leading-none">2</div>
      
      <div class="flex flex-col md:flex-row gap-8 md:gap-16 relative z-10">
        <div class="md:w-1/4">
          <div class="sticky top-10">
            <div class="flex items-center gap-2 mb-4">
              <span class="w-8 h-[2px] bg-[#f9a825]"></span>
              <span class="text-[#f9a825] text-[10px] font-black uppercase tracking-[0.4em]">Phase 02</span>
            </div>
            <h3 class="text-4xl font-black text-slate-900 uppercase tracking-tighter leading-tight">
              <%= civic_topic.main_ideas_heading.presence || "Retirement" %>
            </h3>
          </div>
        </div>
        <div class="md:w-3/4 border-l-8 border-[#f9a825] pl-8 md:pl-12 py-2">
          <div class="prose prose-slate prose-xl max-w-none text-slate-600 leading-relaxed">
            <%= render_lesson_content(civic_topic.main_ideas, civic_topic) %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- PART 3 -->
  <% if civic_topic.criticism.present? %>
    <div class="relative group pt-16 pb-16 px-10 -mx-10 rounded-[3rem] hover:bg-slate-50/50 transition-colors duration-500">
      <!-- Background Number -->
      <div class="absolute -top-10 -left-10 text-[15rem] font-black text-slate-100 pointer-events-none select-none opacity-50 group-hover:text-[#f9a825]/10 transition-colors duration-700 leading-none">3</div>
      
      <div class="flex flex-col md:flex-row gap-8 md:gap-16 relative z-10">
        <div class="md:w-1/4">
          <div class="sticky top-10">
            <div class="flex items-center gap-2 mb-4">
              <span class="w-8 h-[2px] bg-[#f9a825]"></span>
              <span class="text-[#f9a825] text-[10px] font-black uppercase tracking-[0.4em]">Phase 03</span>
            </div>
            <h3 class="text-4xl font-black text-slate-900 uppercase tracking-tighter leading-tight">
              <%= civic_topic.criticism_heading.presence || "Real-World" %>
            </h3>
          </div>
        </div>
        <div class="md:w-3/4 border-l-8 border-[#f9a825] pl-8 md:pl-12 py-2">
          <div class="prose prose-slate prose-xl max-w-none text-slate-600 leading-relaxed">
            <%= render_lesson_content(civic_topic.criticism, civic_topic) %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Exit Ticket -->
  <% if civic_topic.suggested_reading.present? %>
    <div class="mt-24 bg-slate-900 rounded-[3rem] p-10 md:p-16 border-t-8 border-[#f9a825] shadow-2xl relative overflow-hidden group">
      <div class="absolute top-0 right-0 p-12 opacity-10 group-hover:scale-110 transition-transform">
        <i class="fas fa-door-open text-[10rem] text-white"></i>
      </div>
      <div class="relative z-10">
        <div class="flex items-center gap-4 mb-8">
          <div class="w-12 h-12 rounded-full bg-[#f9a825] flex items-center justify-center text-slate-900 shadow-lg">
            <i class="fas fa-ticket-alt text-xl"></i>
          </div>
          <span class="text-[#f9a825] font-black uppercase tracking-[0.3em] text-sm">Session Wrap-up</span>
        </div>
        <h2 class="text-5xl font-black text-white mb-12 tracking-tighter">Exit Ticket</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10">
          <% civic_topic.suggested_reading.split("\n\n").each do |block| %>
            <div class="bg-white/5 border border-white/10 p-8 rounded-[2.5rem] hover:bg-white/10 transition-all duration-500 hover:-translate-y-1">
              <div class="text-white leading-relaxed text-xl font-serif italic">
                <%= render_lesson_content(block, civic_topic, dark_mode: true) %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Teacher Resources Footer -->
  <% if civic_topic.handout_pdf.attached? %>
    <div class="mt-20 bg-slate-50 rounded-[2rem] p-8 md:p-12 border border-slate-200 flex flex-col md:flex-row items-center gap-8">
      <div class="w-16 h-16 rounded-2xl bg-[#f9a825] flex items-center justify-center text-slate-900 shadow-lg flex-shrink-0">
        <i class="fas fa-file-download text-2xl"></i>
      </div>
      <div class="flex-grow text-center md:text-left">
        <h3 class="text-xl font-bold text-slate-900 mb-1">Download Teacher Resources</h3>
        <p class="text-slate-500 mb-0">Get the full PDF lesson plan, student handouts, and teacher guides.</p>
      </div>
      <%= link_to url_for(civic_topic.handout_pdf), class: "btn btn-primary bg-[#f9a825] border-none text-slate-900 hover:bg-slate-900 hover:text-white gap-2 px-8 rounded-xl font-bold shadow-lg transition-all", target: "_blank" do %>
        <i class="fas fa-download"></i>
        Download Materials
      <% end %>
    </div>
  <% end %>
</div>