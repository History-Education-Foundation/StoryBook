<div id="<%= dom_id civic_topic %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= civic_topic.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Bio:</strong>
    <%= civic_topic.bio %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Tagline:</strong>
    <%= civic_topic.tagline %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Contributions:</strong>
    <%= civic_topic.contributions %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Main ideas:</strong>
    <%= civic_topic.main_ideas %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Legacy:</strong>
    <%= civic_topic.legacy %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Suggested reading:</strong>
    <%= civic_topic.suggested_reading %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Main ideas heading:</strong>
    <%= civic_topic.main_ideas_heading %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Bio heading:</strong>
    <%= civic_topic.bio_heading %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Contributions heading:</strong>
    <%= civic_topic.contributions_heading %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Publications:</strong>
    <%= civic_topic.publications %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Publications heading:</strong>
    <%= civic_topic.publications_heading %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Suggested reading heading:</strong>
    <%= civic_topic.suggested_reading_heading %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Quote:</strong>
    <%= civic_topic.quote %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Quote author:</strong>
    <%= civic_topic.quote_author %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Criticism:</strong>
    <%= civic_topic.criticism %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Criticism heading:</strong>
    <%= civic_topic.criticism_heading %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Legacy heading:</strong>
    <%= civic_topic.legacy_heading %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Image filename:</strong>
    <%= civic_topic.image_filename %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Image data:</strong>
    <%= civic_topic.image_data %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Image position:</strong>
    <%= civic_topic.image_position %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Published:</strong>
    <%= civic_topic.published? ? "Yes" : "No" %>
  </div>
</div>
