  <div class="my-5">
    <%= form.label :quote %>
    <%= form.text_area :quote, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": civic_topic.errors[:quote].none?, "border-red-400 focus:outline-red-600": civic_topic.errors[:quote].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :quote_author %>
    <%= form.text_field :quote_author, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": civic_topic.errors[:quote_author].none?, "border-red-400 focus:outline-red-600": civic_topic.errors[:quote_author].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :criticism %>
    <%= form.text_area :criticism, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": civic_topic.errors[:criticism].none?, "border-red-400 focus:outline-red-600": civic_topic.errors[:criticism].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :criticism_heading %>
    <%= form.text_field :criticism_heading, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": civic_topic.errors[:criticism_heading].none?, "border-red-400 focus:outline-red-600": civic_topic.errors[:criticism_heading].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :legacy_heading %>
    <%= form.text_field :legacy_heading, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": civic_topic.errors[:legacy_heading].none?, "border-red-400 focus:outline-red-600": civic_topic.errors[:legacy_heading].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :image_filename %>
    <%= form.text_field :image_filename, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": civic_topic.errors[:image_filename].none?, "border-red-400 focus:outline-red-600": civic_topic.errors[:image_filename].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :image_data %>
    <%= form.text_area :image_data, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": civic_topic.errors[:image_data].none?, "border-red-400 focus:outline-red-600": civic_topic.errors[:image_data].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :image_position %>
    <%= form.text_field :image_position, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": civic_topic.errors[:image_position].none?, "border-red-400 focus:outline-red-600": civic_topic.errors[:image_position].any?}] %>
  </div>

  <div class="my-5 flex items-center gap-2">
    <%= form.label :published %>
    <%= form.check_box :published, class: ["block shadow-sm rounded-md border order-first h-5 w-5", {"border-gray-400 focus:outline-blue-600": civic_topic.errors[:published].none?, "border-red-400 focus:outline-red-600": civic_topic.errors[:published].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
