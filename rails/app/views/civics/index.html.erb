<% content_for :full_width, true %>
<% content_for :hide_header, true %>
<% content_for :hide_navbar, true %>

<div class="min-h-screen bg-white font-sans text-slate-800">
  <%= render 'layouts/navigation' %>

  <!-- Hero/Header Section -->
  <section class="bg-slate-900 py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute inset-0 bg-[#f9a825]/10 mix-blend-overlay"></div>
    </div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 text-center">
      <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">Civics Education Directory</h1>
      <p class="text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed">
        Exploring political figures, historical policies, and the fundamental structures of American governance.
      </p>
    </div>
  </section>

  <!-- Civics Grid Section -->
  <section class="py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <% 
        category_icons = {
          "Political Figures & Policies" => "fa-users-gear",
          "U.S. History" => "fa-flag-usa",
          "World History" => "fa-globe-americas",
          "World Geography" => "fa-map-marked-alt",
          "Financial Literacy" => "fa-hand-holding-dollar",
          "Psychology" => "fa-brain",
          "Digital Literacy" => "fa-laptop-code",
          "Student Leaders" => "fa-graduation-cap"
        }
      %>

      <% @subject_order.each do |subject| %>
        <% topics = @grouped_topics[subject] %>
        <% next if topics.blank? %>

        <div class="mb-24 last:mb-0">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% topics.each do |topic| %>
              <% 
                active_topics = ["Andrew Yang", "James Lindsay", "American Civics Renewal Act", "Lobbying"]
                is_ready = topic.published? && topic.bio.present? && active_topics.include?(topic.name)
              %>
              
              <div class="group relative bg-white rounded-[2rem] border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-500 overflow-hidden">
                <% if is_ready %>
                  <%= link_to civic_path(topic), class: "block h-full" do %>
                    <div class="p-8 flex flex-col h-full">
                      <div class="flex items-start gap-6 mb-6">
                        <div class="w-20 h-20 bg-[#f9a825] rounded-2xl flex items-center justify-center shadow-lg flex-shrink-0 overflow-hidden border-2 border-white transition-transform duration-500 group-hover:scale-110">
                          <% if topic.image.attached? %>
                            <%= image_tag topic.image, class: "w-full h-full object-cover #{topic.image_position || 'object-top'}" %>
                          <% elsif topic.image_data.present? %>
                            <img src="<%= topic.image_data %>" class="w-full h-full object-cover <%= topic.image_position || 'object-top' %>" alt="<%= topic.name %>">
                          <% elsif topic.image_filename.present? %>
                            <%= image_tag topic.image_filename, class: "w-full h-full object-cover #{topic.image_position || 'object-top'}" %>
                          <% else %>
                            <i class="fas fa-landmark text-3xl text-white"></i>
                          <% end %>
                        </div>
                        <div class="pt-2">
                          <h3 class="text-xl font-bold text-slate-900 group-hover:text-[#f9a825] transition-colors line-clamp-2"><%= topic.name %></h3>
                          <% if topic.grade_level.present? %>
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-widest"><%= topic.grade_level %></span>
                          <% end %>
                        </div>
                      </div>
                      
                      <% if topic.tagline.present? %>
                        <p class="text-slate-500 text-sm leading-relaxed mb-6 line-clamp-3">
                          <%= topic.tagline %>
                        </p>
                      <% end %>

                      <div class="mt-auto pt-4 border-t border-slate-50 flex items-center justify-between">
                        <span class="text-xs font-black uppercase tracking-[0.2em] text-[#f9a825]">Explore Topic</span>
                        <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 group-hover:bg-[#f9a825] group-hover:text-white transition-all duration-300">
                          <i class="fas fa-arrow-right text-xs"></i>
                        </div>
                      </div>
                    </div>
                  <% end %>
                <% else %>
                  <div class="p-8 flex flex-col h-full bg-slate-50/50 grayscale opacity-80 group/soon relative overflow-hidden">
                    <div class="absolute top-4 right-4 z-20">
                      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-slate-200 text-[10px] font-black uppercase tracking-widest text-slate-400 shadow-sm">
                        <i class="fas fa-clock text-[8px]"></i>
                        Coming Soon
                      </span>
                    </div>

                    <div class="flex items-start gap-6 mb-6">
                      <div class="w-20 h-20 bg-slate-200 rounded-2xl flex items-center justify-center shadow-inner flex-shrink-0 overflow-hidden border-2 border-white">
                        <% if topic.image.attached? %>
                          <%= image_tag topic.image, class: "w-full h-full object-cover grayscale opacity-50" %>
                        <% elsif topic.image_data.present? %>
                          <img src="<%= topic.image_data %>" class="w-full h-full object-cover grayscale opacity-50" alt="<%= topic.name %>">
                        <% elsif topic.image_filename.present? %>
                          <%= image_tag topic.image_filename, class: "w-full h-full object-cover grayscale opacity-50" %>
                        <% else %>
                          <i class="fas fa-landmark text-3xl text-slate-300"></i>
                        <% end %>
                      </div>
                      <div class="pt-2">
                        <h3 class="text-xl font-bold text-slate-400 mb-1"><%= topic.name %></h3>
                        <% if topic.grade_level.present? %>
                          <span class="text-[10px] font-bold text-slate-300 uppercase tracking-widest"><%= topic.grade_level %></span>
                        <% end %>
                      </div>
                    </div>

                    <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between">
                      <span class="text-xs font-bold uppercase tracking-[0.2em] text-slate-300">In Development</span>
                      <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-200">
                        <i class="fas fa-lock text-[10px]"></i>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Testimonials/Footer Call to Action -->
  <section class="py-16 bg-[#f9a825] text-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-4">Interested in civics?</h2>
      <p class="text-xl mb-8 text-white/90">We are documenting the figures and policies that shape our democracy.</p>
      <%= link_to "/contact", class: "btn btn-outline text-white border-2 border-white hover:bg-white hover:text-slate-900 px-10 rounded-md transition-all font-bold" do %>
        Contact Us
      <% end %>
    </div>
  </section>
</div>