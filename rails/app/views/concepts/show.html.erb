<% content_for :full_width, true %>
<% content_for :hide_header, true %>
<% content_for :hide_navbar, true %>

<div class="min-h-screen bg-white font-sans text-slate-800">
  <%= render 'layouts/navigation' %>

  <!-- Hero/Header Section -->
  <section class="bg-slate-900 py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute inset-0 bg-[#f9a825]/10 mix-blend-overlay"></div>
    </div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
      <%= link_to concepts_path, class: "inline-flex items-center gap-2 text-[#f9a825] hover:text-white transition-colors mb-8 font-medium" do %>
        <i class="fas fa-arrow-left"></i>
        <span>Back to Directory</span>
      <% end %>
      
      <div class="flex flex-col md:flex-row items-center gap-8 md:items-start text-center md:text-left">
        <div class="w-32 h-32 bg-[#f9a825] rounded-full flex items-center justify-center shadow-lg flex-shrink-0 overflow-hidden border-4 border-white/20">
          <% if @concept.image_data.present? %>
            <img src="<%= @concept.image_data %>" class="w-full h-full object-cover <%= @concept.image_position || 'object-top' %>" alt="<%= @concept.name %>">
          <% elsif @concept.image_filename.present? %>
            <%= image_tag @concept.image_filename, class: "w-full h-full object-cover #{@concept.image_position || 'object-top'}" %>
          <% else %>
            <i class="fas fa-lightbulb text-5xl text-white"></i>
          <% end %>
        </div>
        <div>
          <h1 class="text-4xl md:text-6xl font-bold text-white mb-4"><%= @concept.name %></h1>
          <% if @concept.tagline.present? %>
            <%= simple_format(@concept.tagline, { class: "text-lg md:text-xl text-white/90 max-w-3xl leading-relaxed font-medium" }, { wrapper_tag: "div" }) %>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="prose prose-xl prose-slate max-w-none">
        
        <!-- Image Captions / Gallery (Scholar Publications Style) -->
        <% if @concept.publications.present? %>
          <div class="mb-20">
            <% if @concept.publications_heading.present? %>
              <h2 class="text-3xl font-bold text-slate-900 mb-8 border-b-2 border-[#f9a825] pb-4 inline-block"><%= @concept.publications_heading %></h2>
            <% end %>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 bg-slate-50 p-8 rounded-3xl border border-slate-100">
              <% @concept.publications.split("\n").reject(&:blank?).each do |item| %>
                <div class="flex flex-col gap-4">
                  <% 
                    filename, caption = item.include?('|') ? item.split('|', 2) : [nil, item]
                  %>
                  <div class="aspect-video bg-slate-200 rounded-2xl flex items-center justify-center text-slate-400 overflow-hidden shadow-sm border border-slate-200">
                    <% if filename.present? %>
                      <%= image_tag filename, class: "w-full h-full object-cover" %>
                    <% else %>
                      <i class="fas fa-image text-4xl"></i>
                    <% end %>
                  </div>
                  <p class="text-base font-medium text-slate-500 italic px-4 text-center m-0 leading-relaxed"><%= caption %></p>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
        
        <!-- Contributions / Key Figures (Scholar Style Box) -->
        <% if @concept.contributions.present? %>
          <% 
            heading_lower = @concept.contributions_heading&.downcase || ""
            is_grid_layout = heading_lower.include?("figures") || heading_lower.include?("examples") 
          %>
          <div class="mb-20">
            <% if @concept.contributions_heading.present? %>
              <h2 class="text-3xl font-bold text-slate-900 mb-8 border-b-2 border-[#f9a825] pb-4 inline-block"><%= @concept.contributions_heading %></h2>
            <% end %>

            <% if is_grid_layout %>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <% @concept.contributions.split("\n").reject(&:blank?).each do |contribution| %>
                  <div class="card bg-slate-50 border border-slate-100 shadow-sm hover:shadow-lg transition-all rounded-3xl overflow-hidden">
                    <div class="card-body p-8">
                      <% if contribution.include?(":") %>
                        <% parts = contribution.split(":", 2) %>
                        <div class="flex items-center gap-4 mb-4">
                          <div class="w-12 h-12 rounded-full bg-[#f9a825] flex items-center justify-center text-white shadow-md">
                            <i class="fas <%= heading_lower.include?('examples') ? 'fa-monument' : 'fa-user-tie' %>"></i>
                          </div>
                          <h4 class="text-2xl font-bold text-slate-900 m-0"><%= parts[0] %></h4>
                        </div>
                        <p class="text-lg text-slate-600 leading-relaxed m-0"><%= parts[1] %></p>
                      <% else %>
                        <p class="text-lg text-slate-700 font-medium m-0"><%= contribution %></p>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="p-10 bg-slate-50 rounded-3xl border-l-8 border-[#f9a825] shadow-sm relative overflow-hidden">
                <div class="absolute top-0 right-0 p-8 opacity-5">
                  <i class="fas fa-landmark text-8xl text-slate-900"></i>
                </div>
                <div class="relative z-10">
                  <ul class="space-y-6 list-none p-0 m-0">
                    <% @concept.contributions.split("\n").reject(&:blank?).each do |contribution| %>
                      <li class="flex items-start gap-4 text-slate-700 text-lg m-0">
                        <i class="fas fa-check-circle text-[#f9a825] mt-1.5 flex-shrink-0"></i>
                        <% if contribution.include?(":") %>
                          <% parts = contribution.split(":", 2) %>
                          <span>
                            <strong class="text-slate-900 font-bold"><%= parts[0] %>:</strong><%= parts[1] %>
                          </span>
                        <% else %>
                          <span><%= contribution %></span>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

        <!-- Quote Block (Scholar Style) -->
        <% if @concept.quote.present? %>
          <div class="mb-20 bg-slate-900 p-12 rounded-[3rem] relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 w-32 h-32 opacity-10 -ml-10 -mt-10">
              <i class="fas fa-quote-left text-9xl text-white"></i>
            </div>
            <blockquote class="relative z-10 m-0">
              <p class="text-2xl md:text-3xl font-serif text-white italic leading-relaxed mb-8">
                “<%= @concept.quote %>”
              </p>
              <% if @concept.quote_author.present? %>
                <cite class="text-[#f9a825] text-xl font-bold not-italic flex items-center justify-center gap-3">
                  <span class="w-8 h-[1px] bg-[#f9a825]/30"></span>
                  <%= @concept.quote_author %>
                  <span class="w-8 h-[1px] bg-[#f9a825]/30"></span>
                </cite>
              <% end %>
            </blockquote>
          </div>
        <% end %>

        <!-- Main Ideas section removed -->

        <!-- Criticism / Risks (Scholar Style Red Box) -->
        <% if @concept.criticism.present? %>
          <% 
            # Use the custom gold 'Deep Dive' box for specific topics
            analysis_topics = ['Fascism', 'Theocracy', 'Communism']
            use_analysis_box = analysis_topics.include?(@concept.name) || @concept.criticism_heading == 'Structured Academic Controversy'
            
            # Theme colors for the Analysis Box
            accent_color_class = '[#f9a825]'
            box_bg = 'bg-slate-50'
            box_border = 'border-slate-100'
            heading_border = use_analysis_box ? 'border-[#f9a825]' : 'border-red-500'
          %>
          <div class="mb-20">
            <% if @concept.criticism_heading.present? %>
              <h2 class="text-3xl font-bold text-slate-900 mb-10 border-b-2 <%= heading_border %> pb-4 inline-block">
                <%= @concept.criticism_heading %>
              </h2>
            <% end %>
            
            <% if use_analysis_box %>
              <div class="<%= box_bg %> rounded-[2.5rem] p-10 md:p-16 border <%= box_border %> shadow-sm relative overflow-hidden">
                <div class="absolute top-0 right-0 p-12 opacity-[0.03] pointer-events-none">
                  <i class="fas fa-balance-scale text-[12rem] text-slate-900"></i>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-12 relative z-10">
                  <% 
                    all_points = @concept.criticism.split("\n").reject(&:blank?)
                    note = all_points.find { |p| p.start_with?("Note:") }
                    quotes = all_points.select { |p| p.strip.start_with?("“") && p.include?("”") }
                    points = all_points - [note] - quotes
                  %>
                  <% points.each do |item| %>
                    <div>
                      <% if item.include?(":") %>
                        <% parts = item.split(":", 2) %>
                        <h4 class="font-bold text-slate-900 text-xl mb-4 flex items-center gap-3">
                          <span class="w-8 h-[2px] bg-<%= accent_color_class %>"></span>
                          <%= parts[0] %>
                        </h4>
                        <p class="text-lg text-slate-600 leading-relaxed m-0"><%= parts[1] %></p>
                      <% else %>
                        <p class="text-lg text-slate-600 leading-relaxed m-0"><%= item %></p>
                      <% end %>
                    </div>
                  <% end %>
                </div>
                
                <% if note %>
                  <div class="mt-16 pt-12 border-t border-slate-200 relative z-10">
                    <div class="flex items-start gap-6">
                      <div class="w-12 h-12 rounded-2xl bg-<%= accent_color_class %> flex items-center justify-center text-white flex-shrink-0 shadow-lg shadow-[#f9a825]/20">
                        <i class="fas fa-info-circle text-xl"></i>
                      </div>
                      <div>
                        <h4 class="text-lg font-bold text-slate-900 mb-2 uppercase tracking-wider">Analysis Note</h4>
                        <div class="text-slate-600 text-lg leading-relaxed italic m-0">
                          <%= simple_format note.sub("Note:", "").strip %>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="space-y-6">
                <% 
                  all_points = @concept.criticism.split("\n").reject(&:blank?)
                  quotes = all_points.select { |p| p.strip.start_with?("“") && p.include?("”") }
                  points = all_points - quotes
                %>
                <% points.each do |item| %>
                  <div class="flex gap-6 items-start p-8 bg-red-50/50 rounded-3xl border border-red-100 shadow-sm">
                    <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
                      <i class="fas fa-exclamation-triangle text-red-500"></i>
                    </div>
                    <div class="text-slate-700 text-lg m-0 leading-relaxed">
                      <% if item.include?(":") %>
                        <% parts = item.split(":", 2) %>
                        <strong class="text-slate-900 font-bold"><%= parts[0] %>:</strong><%= parts[1] %>
                      <% else %>
                        <%= item %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <!-- Extra Quotes Section (Pulled from Criticism) -->
          <% 
            all_points = @concept.criticism.split("\n").reject(&:blank?)
            extracted_quotes = all_points.select { |p| p.strip.start_with?("“") && p.include?("”") }
          %>
          <% if extracted_quotes.any? %>
            <div class="mb-20">
              <h2 class="text-3xl font-bold text-slate-900 mb-10 border-b-2 border-[#f9a825] pb-4 inline-block">
                Historical Perspectives
              </h2>
              <div class="space-y-8">
                <% extracted_quotes.each do |item| %>
                  <div class="bg-slate-900 p-12 rounded-[3rem] relative overflow-hidden text-center shadow-xl">
                    <div class="absolute top-0 left-0 w-32 h-32 opacity-10 -ml-10 -mt-10">
                      <i class="fas fa-quote-left text-9xl text-white"></i>
                    </div>
                    <blockquote class="relative z-10 m-0 border-none p-0">
                      <% if item.include?(" – ") %>
                        <% quote_parts = item.split(" – ", 2) %>
                        <p class="text-2xl md:text-3xl font-serif text-white italic leading-relaxed mb-8">
                          <%= quote_parts[0] %>
                        </p>
                        <cite class="text-[#f9a825] text-xl font-bold not-italic flex items-center justify-center gap-3">
                          <span class="w-8 h-[1px] bg-[#f9a825]/30"></span>
                          <%= quote_parts[1] %>
                          <span class="w-8 h-[1px] bg-[#f9a825]/30"></span>
                        </cite>
                      <% elsif item.include?(" - ") %>
                        <% quote_parts = item.split(" - ", 2) %>
                        <p class="text-2xl md:text-3xl font-serif text-white italic leading-relaxed mb-8">
                          <%= quote_parts[0] %>
                        </p>
                        <cite class="text-[#f9a825] text-xl font-bold not-italic flex items-center justify-center gap-3">
                          <span class="w-8 h-[1px] bg-[#f9a825]/30"></span>
                          <%= quote_parts[1] %>
                          <span class="w-8 h-[1px] bg-[#f9a825]/30"></span>
                        </cite>
                      <% else %>
                        <p class="text-2xl md:text-3xl font-serif text-white italic leading-relaxed m-0">
                          <%= item %>
                        </p>
                      <% end %>
                    </blockquote>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>

        <!-- Legacy section removed -->

        <!-- Suggested Reading / Inquiry (Scholar Style List) -->
        <% if @concept.suggested_reading.present? %>
          <div class="mb-20">
            <% if @concept.suggested_reading_heading.present? %>
              <h2 class="text-3xl font-bold text-slate-900 mb-10 border-b-2 border-[#f9a825] pb-4 inline-block">
                <%= @concept.suggested_reading_heading %>
              </h2>
            <% end %>
            <div class="grid grid-cols-1 gap-4">
              <% @concept.suggested_reading.split("\n").reject(&:blank?).each do |reading| %>
                <% 
                  text = reading
                  url = nil
                  if reading.include?("(") && reading.include?(")")
                    parts = reading.match(/(.*)\((.*)\)/)
                    if parts
                      text = parts[1].strip
                      url = parts[2].strip
                    end
                  elsif reading.include?("http")
                    # simple heuristic
                    parts = reading.split("http", 2)
                    text = parts[0].strip
                    url = "http" + parts[1].strip
                  end
                %>
                <% if url.present? %>
                  <%= link_to url, target: "_blank", class: "flex items-center gap-4 p-6 bg-white border border-slate-100 rounded-2xl hover:bg-slate-50 hover:border-[#f9a825]/30 transition-all group shadow-sm" do %>
                    <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0 group-hover:bg-[#f9a825]/10">
                      <i class="fas fa-external-link-alt text-slate-400 group-hover:text-[#f9a825] transition-colors"></i>
                    </div>
                    <span class="text-lg text-slate-700 font-medium leading-snug"><%= text %></span>
                  <% end %>
                <% else %>
                  <div class="flex items-center gap-4 p-6 bg-white border border-slate-100 rounded-2xl hover:bg-slate-50 hover:border-[#f9a825]/30 transition-all group shadow-sm">
                    <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0 group-hover:bg-[#f9a825]/10">
                      <i class="fas fa-question-circle text-slate-400 group-hover:text-[#f9a825] transition-colors"></i>
                    </div>
                    <span class="text-lg text-slate-700 font-medium leading-snug"><%= reading %></span>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Footer -->
        <div class="mt-24 pt-12 border-t border-slate-100 text-slate-400 text-sm text-center italic">
          <p>© 2024 The History Education Foundation | Images from Wikimedia Commons</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer Call to Action -->
  <section class="py-16 bg-[#f9a825] text-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-4">Support Our Historical Research</h2>
      <p class="text-xl mb-8 text-white/90">Help us continue providing high-quality resources for understanding key historical concepts.</p>
      <%= link_to "/contact", class: "btn btn-outline text-white border-2 border-white hover:bg-white hover:text-slate-900 px-10 rounded-md transition-all font-bold" do %>
        Contact Us
      <% end %>
    </div>
  </section>
</div>
