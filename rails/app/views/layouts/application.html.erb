<!DOCTYPE html>
<html data-theme="light">
  <head>
    <title><%= content_for(:title) || "Rails Basic" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <!-- Prevent caching to ensure fresh request_path and view_path -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!-- html2canvas for screenshot capture + Fabric.js for annotation -->
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.1/fabric.min.js"></script>

    <%= render 'layouts/llamapress_page_context' %>

    <%= yield :head %>

    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <%= favicon_link_tag 'favicon.png' %>
    <%= favicon_link_tag 'favicon.png', rel: 'apple-touch-icon' %>
    <!-- Tailwind CSS v3 + DaisyUI v4 (compatible versions) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.10/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              'llama-purple': '#4C3F6D',
              'llama-blue': '#489DF9',
              'llama-dark': '#2D2442',
            }
          }
        }
      }
    </script>

    <!-- Font Awesome (public CDN) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" data-llama-id="6" data-llama-editable="true">

    <%# stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= render 'shared/toast' %>
    <script>
      // Make toast functions globally available immediately
      window.showSaveToast = showSaveToast;
      window.showAlertToast = showAlertToast;
    </script>
  </head>

  <body class="h-full bg-base-200 min-h-screen text-slate-900">
    <% unless content_for?(:hide_navbar) %>
      <%= render 'shared/navbar' %>
    <% end %>

    <div class="<%= content_for?(:full_width) ? '' : 'py-6' %>">
      <% if flash.any? %>
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mb-4">
          <% flash.each do |key, value| %>
            <div class="alert <%= key == 'notice' ? 'alert-success' : 'alert-error' %> shadow-lg mb-2">
              <i class="fas <%= key == 'notice' ? 'fa-check-circle' : 'fa-exclamation-circle' %>"></i>
              <span><%= value %></span>
            </div>
          <% end %>
        </div>
      <% end %>

      <% unless content_for?(:hide_header) %>
        <header>
          <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <h1 class="text-3xl font-bold leading-tight tracking-tight text-base-content">
              <%= content_for(:header) %>
            </h1>
          </div>
        </header>
      <% end %>
      <main>
        <% if content_for?(:full_width) %>
          <%= yield %>
        <% else %>
          <div class="mx-auto max-w-7xl sm:px-6 lg:px-8">
            <div class="px-4 py-8 sm:px-0">
              <%= yield %>
            </div>
          </div>
        <% end %>
      </main>
    </div>

    <%= render 'shared/footer' %>
  </body>
</html>
