<% content_for :full_width, true %>
<% content_for :hide_header, true %>
<% content_for :hide_navbar, true %>

<div class="min-h-screen bg-white font-sans text-slate-800">
  <%= render 'layouts/navigation' %>

  <!-- Hero Section -->
  <section class="bg-slate-900 py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute inset-0 bg-[#f9a825]/10 mix-blend-overlay"></div>
    </div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 text-center">
      <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">Lesson Plans</h1>
      <p class="text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed">
        Access dedicated educational resources for specific grade levels and subjects to enhance learning and teaching.
      </p>
    </div>
  </section>

  <!-- Lesson Plans Grid Section -->
  <section class="py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @lesson_plans_config.each do |config| %>
          <% 
            topics = CivicTopic.published
            topics = topics.where(grade_level: config[:grade]) if config[:grade]
            topics = topics.where(subject: config[:subject]) if config[:subject]
          %>
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200 flex flex-col overflow-hidden group hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
            <div class="p-8 flex flex-col items-center text-center flex-grow">
              <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mb-6 group-hover:bg-[#f9a825]/10 group-hover:rotate-3 transition-all duration-300">
                <i class="fas fa-book-open text-2xl text-slate-400 group-hover:text-[#f9a825] transition-colors"></i>
              </div>
              
              <div class="mb-4">
                <h3 class="text-xl font-bold text-slate-900 mb-1"><%= config[:display] %></h3>
                <% if topics.any? %>
                  <span class="badge badge-sm bg-[#f9a825]/10 text-[#f9a825] border-none font-bold uppercase tracking-wider">
                    <%= pluralize(topics.count, "Plan") %>
                  </span>
                <% end %>
              </div>

              <% if topics.any? %>
                <div class="w-full mt-6 space-y-2">
                  <% topics.each do |topic| %>
                    <% is_placeholder = topic.bio.to_s.include?("Placeholder") %>
                    <% if is_placeholder %>
                      <div class="flex items-center p-3 rounded-xl bg-slate-50/50 border border-slate-100 opacity-60 cursor-not-allowed">
                        <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center mr-3">
                          <i class="fas fa-clock text-xs text-slate-400"></i>
                        </div>
                        <span class="text-sm font-semibold text-slate-400 flex-grow text-left">
                          <%= topic.name %>
                        </span>
                        <span class="text-[8px] font-black uppercase tracking-widest text-slate-400 border border-slate-200 px-2 py-1 rounded">
                          Soon
                        </span>
                      </div>
                    <% else %>
                      <%= link_to lesson_plan_path(topic), class: "flex items-center p-3 rounded-xl hover:bg-slate-50 transition-all group/link border border-transparent hover:border-slate-100" do %>
                        <div class="w-8 h-8 rounded-lg bg-slate-50 flex items-center justify-center mr-3 group-hover/link:bg-white transition-colors">
                          <i class="fas fa-file-alt text-xs text-slate-400 group-hover/link:text-[#f9a825]"></i>
                        </div>
                        <span class="text-sm font-semibold text-slate-600 group-hover/link:text-slate-900 transition-colors flex-grow text-left">
                          <%= topic.name %>
                        </span>
                        <i class="fas fa-arrow-right text-[10px] text-slate-300 group-hover/link:text-[#f9a825] group-hover/link:translate-x-1 transition-all"></i>
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
              <% else %>
                <div class="mt-auto pt-6">
                  <span class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 bg-slate-50 px-4 py-2 rounded-lg border border-slate-100">
                    Coming Soon
                  </span>
                </div>
              <% end %>
            </div>
            

          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Footer Call to Action -->
  <section class="py-16 bg-[#f9a825] text-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-4">Need specific resources?</h2>
      <p class="text-xl mb-8 text-white/90">We are constantly updating our lesson plans and educational materials.</p>
      <%= link_to "/contact", class: "btn btn-outline text-white border-2 border-white hover:bg-white hover:text-slate-900 px-10 rounded-md transition-all font-bold" do %>
        Contact Us
      <% end %>
    </div>
  </section>
</div>
