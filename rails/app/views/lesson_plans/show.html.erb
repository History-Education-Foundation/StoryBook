<% content_for :full_width, true %>
<% content_for :hide_header, true %>
<% content_for :hide_navbar, true %>

<div class="min-h-screen bg-white font-sans text-slate-800 <%= 'dossier-theme' if [17, 18, 23, 63, 68, 76].include?(@civic_topic.id) || @civic_topic.name.include?('Pinochet') %>">
  <%= render 'layouts/navigation' %>

  <!-- Hero/Header Section -->
  <section class="bg-slate-900 py-32 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute inset-0 bg-gradient-to-br from-[#f9a825]/20 to-transparent mix-blend-overlay"></div>
      <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-10"></div>
    </div>
    
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
      <% if [17, 18, 23, 63, 68, 76].include?(@civic_topic.id) || @civic_topic.name.include?('Pinochet') %>
        <div class="absolute -top-12 -right-12 opacity-20 pointer-events-none rotate-12 select-none z-0">
          <div class="border-[12px] border-[#8b0000] text-[#8b0000] font-mono text-8xl font-black px-12 py-6 uppercase tracking-tighter shadow-2xl">
            Confidential
          </div>
        </div>
      <% end %>

      <%= link_to lesson_plans_path, class: "group inline-flex items-center gap-3 text-[#f9a825] hover:text-white transition-all mb-12 font-bold tracking-widest uppercase text-xs" do %>
        <i class="fas fa-arrow-left group-hover:-translate-x-1 transition-transform"></i>
        <span>Back to Lesson Plans</span>
      <% end %>
      
      <div class="flex flex-col md:flex-row items-center gap-12 md:items-start text-center md:text-left">
        <div class="w-40 h-40 bg-[#f9a825] rounded-3xl flex items-center justify-center shadow-[0_20px_50px_rgba(249,168,37,0.3)] flex-shrink-0 overflow-hidden border-4 border-white/10 group hover:rotate-2 transition-all duration-500">
          <% if @civic_topic.image.attached? %>
            <%= image_tag @civic_topic.image, class: "w-full h-full object-cover #{@civic_topic.image_position || 'object-top'} group-hover:scale-110 transition-transform duration-700" %>
          <% elsif @civic_topic.image_data.present? %>
            <img src="<%= @civic_topic.image_data %>" class="w-full h-full object-cover <%= @civic_topic.image_position || 'object-top' %> group-hover:scale-110 transition-transform duration-700" alt="<%= @civic_topic.name %>">
          <% else %>
            <i class="fas fa-book-open text-6xl text-white group-hover:scale-110 transition-transform duration-700"></i>
          <% end %>
        </div>
        <div class="space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f9a825]/10 border border-[#f9a825]/20">
            <span class="w-2 h-2 rounded-full bg-[#f9a825] animate-pulse"></span>
            <span class="text-[#f9a825] text-[10px] font-black uppercase tracking-widest">Active Lesson Plan</span>
          </div>
          <h1 class="text-5xl md:text-7xl font-black text-white tracking-tighter leading-none"><%= @civic_topic.name %></h1>
          <% if @civic_topic.tagline.present? %>
            <div class="text-xl md:text-2xl text-slate-300 max-w-3xl leading-relaxed font-medium italic border-l-4 border-[#f9a825] pl-6 py-2 bg-white/5 rounded-r-xl">
              <%= @civic_topic.tagline %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <%= render 'civic_topics/topic_detail', civic_topic: @civic_topic %>

  <!-- Footer Call to Action -->
  <section class="py-16 bg-[#f9a825] text-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-4">Support Our Historical Research</h2>
      <p class="text-xl mb-8 text-white/90">Help us continue providing high-quality resources for understanding key historical concepts.</p>
      <%= link_to "/contact", class: "btn btn-outline text-white border-2 border-white hover:bg-white hover:text-slate-900 px-10 rounded-md transition-all font-bold" do %>
        Contact Us
      <% end %>
    </div>
  </section>
</div>
