<% content_for :full_width, true %>
<% content_for :hide_header, true %>
<% content_for :hide_navbar, true %>

<div class="min-h-screen bg-white font-sans text-slate-800">
  <%= render 'layouts/navigation' %>

  <!-- Hero Section -->
  <section class="bg-slate-900 py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute inset-0 bg-[#f9a825]/10 mix-blend-overlay"></div>
    </div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 text-center">
      <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">Our Blog</h1>
      <p class="text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed">
        Stay updated with the latest news, research, and stories from our community.
      </p>
    </div>
  </section>

  <!-- Blog Posts Grid -->
  <section class="py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <% if @posts.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <% @posts.each do |post| %>
            <%= link_to post_path(post), class: "card bg-white shadow-sm hover:shadow-xl transition-all duration-300 group flex flex-col h-full border border-slate-100 overflow-hidden" do %>
              <div class="p-8 flex flex-col flex-grow">
                <% if post.category %>
                  <span class="text-[#f9a825] font-bold text-xs uppercase tracking-widest mb-4"><%= post.category.name %></span>
                <% end %>
                
                <h2 class="text-2xl font-bold text-slate-900 mb-4 group-hover:text-[#f9a825] transition-colors leading-tight">
                  <%= post.title %>
                </h2>
                
                <p class="text-slate-600 mb-6 flex-grow leading-relaxed">
                  <%= truncate(post.body, length: 150) %>
                </p>
                
                <div class="flex items-center justify-between mt-auto pt-6 border-t border-slate-50">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-slate-100 rounded-full flex items-center justify-center text-sm text-[#f9a825] font-bold">
                      <%= (post.author&.name || "A").first.upcase %>
                    </div>
                    <div class="flex flex-col">
                      <span class="text-sm font-bold text-slate-900"><%= post.author&.name || "Anonymous" %></span>
                      <span class="text-xs text-slate-500"><%= post.created_at.strftime("%B %d, %Y") %></span>
                    </div>
                  </div>
                  <i class="fas fa-arrow-right text-slate-300 group-hover:text-[#f9a825] transition-colors"></i>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-12">
          <div class="w-20 h-20 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="far fa-newspaper text-3xl text-slate-300"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">No blog posts found</h3>
          <p class="text-slate-500">Check back soon for new content!</p>
        </div>
      <% end %>
    </div>
  </section>
</div>
