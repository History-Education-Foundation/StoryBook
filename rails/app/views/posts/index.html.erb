<% content_for :full_width, true %>
<% content_for :hide_header, true %>
<% content_for :hide_navbar, true %>

<div class="min-h-screen bg-white font-sans text-slate-800">
  <%= render 'layouts/navigation' %>

  <!-- Hero Section -->
  <section class="bg-slate-900 py-24 relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute inset-0 bg-[#f9a825]/10 mix-blend-overlay"></div>
    </div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10 text-center">
      <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">Our Blog</h1>
      <p class="text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed mb-8">
        Stay updated with the latest news, research, and stories from our community.
      </p>

      <% if user_signed_in? %>
        <%= link_to new_post_path, class: "btn btn-primary btn-lg gap-2 shadow-lg" do %>
          <i class="fas fa-plus"></i>
          New Post
        <% end %>
      <% end %>
    </div>
  </section>

  <!-- Blog Posts Grid -->
  <section class="py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <% if @posts.any? %>
        <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <% @posts.each do |post| %>
            <%= render post %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-12">
          <div class="w-20 h-20 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <i class="far fa-newspaper text-3xl text-slate-300"></i>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">No blog posts found</h3>
          <p class="text-slate-500">Check back soon for new content!</p>
        </div>
      <% end %>
    </div>
  </section>
</div>
