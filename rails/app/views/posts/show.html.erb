<% content_for :full_width, true %>
<% content_for :hide_header, true %>
<% content_for :hide_navbar, true %>

<div class="min-h-screen bg-white font-sans text-slate-800">
  <%= render 'layouts/navigation' %>

  <article class="py-24">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <!-- Article Header -->
      <header class="mb-12">
        <% if @post.category %>
          <span class="text-[#f9a825] font-bold text-xs uppercase tracking-widest mb-4 block"><%= @post.category.name %></span>
        <% end %>
        
        <h1 class="text-4xl md:text-5xl font-bold text-slate-900 mb-8 leading-tight tracking-tight">
          <%= @post.title %>
        </h1>
        
        <div class="flex items-center gap-4 py-8 border-y border-slate-100">
          <div class="w-12 h-12 bg-slate-100 rounded-full flex items-center justify-center text-lg text-[#f9a825] font-bold">
            <%= (@post.author&.name || "A").first.upcase %>
          </div>
          <div class="flex flex-col">
            <span class="text-base font-bold text-slate-900"><%= @post.author&.name || "Anonymous" %></span>
            <span class="text-sm text-slate-500"><%= @post.created_at.strftime("%B %d, %Y") %></span>
          </div>
        </div>
      </header>

      <!-- Article Content -->
      <div class="prose prose-lg max-w-none prose-slate prose-headings:font-bold prose-headings:text-slate-900 prose-p:leading-relaxed prose-p:text-slate-600 prose-a:text-[#f9a825] hover:prose-a:text-[#f9a825]/80 transition-colors">
        <%= simple_format @post.body %>
      </div>

      <!-- Article Footer -->
      <footer class="mt-16 pt-12 border-t border-slate-100">
        <%= link_to posts_path, class: "btn btn-ghost text-slate-500 hover:text-[#f9a825] px-0 gap-2 font-bold" do %>
          <i class="fas fa-arrow-left"></i>
          Back to all posts
        <% end %>
      </footer>
    </div>
  </article>
</div>
