<% content_for :full_width, true %>
<% content_for :hide_header, true %>
<% content_for :hide_navbar, true %>

<div class="min-h-screen bg-white font-sans text-slate-800">
  <!-- Custom Header extracted to partial -->
  <%= render 'layouts/navigation' %>

  <!-- Hero Section -->
  <section class="hero min-h-[75vh] relative overflow-hidden" style="background-image: url(<%= asset_path('1000564434.jpg') %>); background-position: center; background-size: cover;">
    <div class="hero-overlay bg-black/35"></div>
    <div class="hero-content text-center text-neutral-content py-20">
      <div class="max-w-7xl px-4">
        <h1 class="mb-10 text-5xl md:text-8xl font-bold text-white leading-tight tracking-tight">
          Building Civic Literacy for a Healthier Democracy
        </h1>
        <p class="mb-12 text-xl md:text-2xl text-white/95 leading-relaxed max-w-4xl mx-auto font-medium">
          We equip students, educators, and communities with the tools to understand civic institutions, evaluate information critically, and engage responsibly in public life.
        </p>
        <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
          <%= link_to "#mission", class: "btn btn-lg bg-[#f9a825] hover:bg-[#f57f17] border-none text-white px-12 rounded-md shadow-xl transition-all hover:scale-105 active:scale-95 text-lg" do %>
            Learn More
          <% end %>
          <%= link_to contact_path, class: "btn btn-lg btn-outline text-white border-2 border-white hover:bg-white hover:text-slate-900 px-12 rounded-md transition-all hover:scale-105 active:scale-95 text-lg" do %>
            Contact Us
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Pillars Section -->
  <section class="py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
        <!-- Critical Thinking -->
        <div class="flex flex-col items-center group">
          <div class="w-20 h-20 bg-[#f9a825] rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm transition-transform duration-300 group-hover:scale-110 group-hover:shadow-lg">
            <img src="<%= asset_path('neve-fse-img01.svg') %>" alt="Critical Thinking" class="w-10 h-10 brightness-0 invert">
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-4">Critical Thinking</h3>
          <p class="text-lg text-slate-600 leading-relaxed">
            Developing the skills to analyze information objectively, evaluate evidence, and form reasoned judgments on complex issues.
          </p>
        </div>

        <!-- Media Awareness -->
        <div class="flex flex-col items-center group">
          <div class="w-20 h-20 bg-[#f9a825] rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm transition-transform duration-300 group-hover:scale-110 group-hover:shadow-lg">
            <img src="<%= asset_path('neve-fse-img02.svg') %>" alt="Media Awareness" class="w-10 h-10 brightness-0 invert">
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-4">Media Awareness</h3>
          <p class="text-lg text-slate-600 leading-relaxed">
            Understanding how media influences perceptions and learning to identify bias, misinformation, and credible sources.
          </p>
        </div>

        <!-- Civic Engagement -->
        <div class="flex flex-col items-center group">
          <div class="w-20 h-20 bg-[#f9a825] rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm transition-transform duration-300 group-hover:scale-110 group-hover:shadow-lg">
            <img src="<%= asset_path('neve-fse-img03.svg') %>" alt="Civic Engagement" class="w-10 h-10 brightness-0 invert">
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-4">Civic Engagement</h3>
          <p class="text-lg text-slate-600 leading-relaxed">
            Empowering individuals to participate meaningfully in democratic life through informed action and community involvement.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section id="mission" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <!-- Logo on the Left -->
        <div class="flex-1 flex justify-center lg:justify-start">
          <img src="<%= asset_path('logo-transparent.png') %>" alt="Foundation Logo" class="h-48 lg:h-64 w-auto object-contain transition-transform duration-500 hover:scale-105">
        </div>
        
        <!-- Text on the Right -->
        <div class="flex-1 text-center lg:text-left">
          <h2 class="text-4xl lg:text-5xl font-bold text-slate-900 mb-8 leading-tight">Our Mission and What We Do</h2>
          <div class="prose prose-lg text-slate-600 space-y-6 max-w-none">
            <p class="text-xl leading-relaxed">
              We believe a healthy democracy depends on an informed public. Our nonprofit works to expand civic literacy and media education, giving individuals the knowledge and skills they need to understand institutions, assess information critically, and participate meaningfully in civic life.
            </p>
            <p class="text-xl leading-relaxed">
              Through educational resources and public-facing programs, we help communities build the foundation for thoughtful civic engagement in an evolving media landscape.
            </p>
          </div>
          <%= link_to new_user_registration_path, class: "btn bg-[#f9a825] hover:bg-[#f57f17] border-none text-white px-10 rounded-md shadow-lg mt-10 transition-all hover:scale-105 active:scale-95 text-lg inline-flex items-center gap-2" do %>
            <span>Support Us</span>
            <i class="fas fa-arrow-right text-sm"></i>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <!-- Media Literacy Section -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <!-- Text on the Left (desktop) -->
        <div class="flex-1">
          <h2 class="text-3xl font-bold text-slate-900 mb-6">Why Civic & Media Literacy Matter</h2>
          <p class="text-lg text-slate-600 mb-8 leading-relaxed">
            The stability of a democracy depends on having citizens who know how to push for good policy and have the ability to sort through propaganda. Civic literacy helps people understand institutions, citizen rights and responsibilities, and how public decisions are made. Media literacy enables individuals to evaluate information, recognize bias and misinformation, and engage with diverse perspectives. Together, these skills are vital in an era of rapid information flow and complex civic life. Strengthening civic and media literacy promotes informed participation, respectful discourse, and trust in democratic processes. Individuals with historical background knowledge also have higher levels of civic and media literacy.
          </p>
          <%= link_to "#", class: "btn bg-[#f9a825] hover:bg-[#f57f17] border-none text-white px-10 rounded-md shadow-lg transition-all hover:scale-105 active:scale-95 text-lg inline-flex items-center gap-2" do %>
            <span>Learn More</span>
            <i class="fas fa-arrow-right text-sm"></i>
          <% end %>
        </div>
        <!-- Image on the Right (desktop) -->
        <div class="flex-1">
          <div class="rounded-2xl overflow-hidden shadow-xl border border-slate-100">
            <img src="<%= asset_path('neve-fse-img10.jpg') %>" alt="Why Civic and Media Literacy Matter" class="w-full h-auto">
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Audience Section -->
  <section class="py-24 bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <div class="flex-1 relative">
          <div class="rounded-2xl overflow-hidden shadow-2xl">
            <img src="<%= asset_path('1000564435-2048x1365.jpg') %>" alt="Who we serve" class="w-full h-auto object-cover">
          </div>
        </div>
        <div class="flex-1">
          <h2 class="text-3xl font-bold mb-6">Who We Serve</h2>
          <p class="text-lg text-slate-400 mb-8 leading-relaxed">
            We serve educators, students, community organizations, and members of the public who are committed to strengthening civic understanding and media literacy. Our resources support classroom instruction, community-based learning, and individual engagement, and are designed to be accessible, nonpartisan, and adaptable across diverse educational and civic contexts.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 mt-8">
            <%= link_to "#", class: "btn bg-[#f9a825] hover:bg-[#f57f17] border-none text-white px-8 rounded-md shadow-lg transition-all" do %>
              Learn More
            <% end %>
            <%= link_to contact_path, class: "btn btn-outline text-white border-2 border-white hover:bg-white hover:text-slate-900 px-8 rounded-md transition-all" do %>
              Get in touch
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Work Section -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-slate-900 mb-12">Featured Work</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Media Literacy Workshops -->
        <div class="relative overflow-hidden group rounded-2xl shadow-lg aspect-[3/2]">
          <%= image_tag "youngsters-studying-with-laptop-library-1536x1024.jpg", class: "w-full h-full object-cover transition-transform duration-500 group-hover:scale-105", alt: "Media Literacy Workshops" %>
          <div class="absolute inset-0 flex items-end justify-start p-8">
            <div class="border-2 border-white px-8 py-3 rounded-md backdrop-blur-[2px] bg-black/20">
              <span class="text-white text-xl md:text-2xl font-bold block">Media Literacy Workshops</span>
            </div>
          </div>
        </div>

        <!-- Community Civic Programs -->
        <div class="relative overflow-hidden group rounded-2xl shadow-lg aspect-[3/2]">
          <%= image_tag "medium-shot-smiley-people-holding-books-1536x1024.jpg", class: "w-full h-full object-cover transition-transform duration-500 group-hover:scale-105", alt: "Community Civic Programs" %>
          <div class="absolute inset-0 flex items-end justify-start p-8">
            <div class="border-2 border-white px-8 py-3 rounded-md backdrop-blur-[2px] bg-black/20">
              <span class="text-white text-xl md:text-2xl font-bold block">Community Civic Programs</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-16 bg-[#f9a825] text-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-12">
        <!-- Value Prop -->
        <div class="flex flex-col">
          <p class="text-lg md:text-xl font-medium leading-relaxed">
            We provide easy to use lesson plans that help teachers create lessons that improve critical thinking.
          </p>
        </div>

        <!-- Testimonial 1 -->
        <div class="flex flex-col">
          <p class="text-lg md:text-xl font-medium leading-relaxed mb-4 italic">
            “This organization brings clarity to complex civic topics, supporting informed discussion without pushing an agenda in educational and community settings across diverse.”
          </p>
          <p class="text-base font-bold uppercase tracking-wide">Jonathan Reyes</p>
        </div>

        <!-- Testimonial 2 -->
        <div class="flex flex-col">
          <p class="text-lg md:text-xl font-medium leading-relaxed mb-4 italic">
            “The resources are thoughtfully designed and genuinely useful in the classroom, helping students understand civic systems while developing critical media skills responsibly.”
          </p>
          <p class="text-base font-bold uppercase tracking-wide">Melissa Carter</p>
        </div>
      </div>
    </div>
  </section>
</div>
