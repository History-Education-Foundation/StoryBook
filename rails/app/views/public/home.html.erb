<% content_for :full_width, true %>
<% content_for :hide_header, true %>

<div class="min-h-screen bg-white font-sans text-slate-800">
  <!-- Hero Section -->
  <section class="relative bg-white pt-16 pb-20 px-6 lg:pt-24 lg:pb-28 lg:px-8">
    <div class="relative max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-12">
      <div class="flex-1 text-left">
        <h1 class="text-4xl tracking-tight font-extrabold text-slate-900 sm:text-5xl md:text-6xl mb-6">
          <span class="block">History & Media</span>
          <span class="block text-primary">Education</span>
        </h1>
        <p class="mt-6 text-xl text-slate-600 leading-relaxed max-w-2xl">
          We equip students, educators, and communities with the tools to understand civic institutions, evaluate information critically, and engage responsibly in public life.
        </p>
        <div class="mt-10 flex gap-4">
          <%= link_to "#mission", class: "btn btn-primary btn-lg rounded-md px-8" do %>
            Our Mission
          <% end %>
          <%= link_to new_user_registration_path, class: "btn btn-ghost btn-lg border-slate-200 rounded-md px-8" do %>
            Get Started
          <% end %>
        </div>
      </div>
      <div class="flex-1 relative">
        <div class="rounded-2xl overflow-hidden shadow-2xl">
          <img src="https://www.history-education.org/wp-content/uploads/2025/12/1000564435-scaled.jpg" alt="Students learning history" class="w-full h-auto object-cover">
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section id="mission" class="py-24 bg-slate-50">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-center text-slate-900 mb-12">Our Mission and What We Do</h2>
      <div class="prose prose-lg text-slate-600 mx-auto space-y-8">
        <p class="text-center text-xl leading-relaxed">
          We believe a healthy democracy depends on an informed public. Our nonprofit works to expand civic literacy and media education, giving individuals the knowledge and skills they need to understand institutions, assess information critically, and participate meaningfully in civic life.
        </p>
        <p class="text-center text-xl leading-relaxed">
          Through educational resources and public-facing programs, we help communities build the foundation for thoughtful civic engagement in an evolving media landscape.
        </p>
      </div>
    </div>
  </section>

  <!-- Media Literacy Section -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <div class="flex-1 order-2 lg:order-1">
          <div class="rounded-2xl overflow-hidden shadow-xl border border-slate-100">
            <img src="https://www.history-education.org/wp-content/uploads/2025/12/medium-shot-smiley-people-holding-books-1024x683.jpg" alt="Media Literacy" class="w-full h-auto">
          </div>
        </div>
        <div class="flex-1 order-1 lg:order-2">
          <h2 class="text-3xl font-bold text-slate-900 mb-6">Media Literacy</h2>
          <p class="text-lg text-slate-600 mb-8 leading-relaxed">
            Media literacy enables individuals to evaluate information, recognize bias and misinformation, and engage with diverse perspectives. Explore our programs, educational resources, and research-informed approach to strengthening civic literacy and media education, supporting critical thinking, informed participation, and responsible engagement within today’s complex and evolving information environment.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Audience Section -->
  <section class="py-24 bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <div class="flex-1">
          <h2 class="text-3xl font-bold mb-6">Who We Serve</h2>
          <p class="text-lg text-slate-400 mb-8 leading-relaxed">
            We serve educators, students, community organizations, and members of the public who are committed to strengthening civic understanding and media literacy.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="flex items-center gap-3">
              <i class="fas fa-check-circle text-primary"></i>
              <span>Educators</span>
            </div>
            <div class="flex items-center gap-3">
              <i class="fas fa-check-circle text-primary"></i>
              <span>Students</span>
            </div>
            <div class="flex items-center gap-3">
              <i class="fas fa-check-circle text-primary"></i>
              <span>Community Organizations</span>
            </div>
            <div class="flex items-center gap-3">
              <i class="fas fa-check-circle text-primary"></i>
              <span>General Public</span>
            </div>
          </div>
        </div>
        <div class="flex-1 relative">
          <div class="rounded-2xl overflow-hidden shadow-2xl">
            <img src="https://www.history-education.org/wp-content/uploads/2025/12/youngsters-studying-with-laptop-library-1024x683.jpg" alt="Who we serve" class="w-full h-auto object-cover">
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 bg-white">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <div class="bg-primary/5 rounded-3xl p-12 lg:p-20 border border-primary/10">
        <h2 class="text-4xl font-bold text-slate-900 mb-6">Ready to Support Our Mission?</h2>
        <p class="text-xl text-slate-600 mb-10 leading-relaxed max-w-2xl mx-auto">
          Join us in building the foundation for thoughtful civic engagement in an evolving media landscape.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <%= link_to new_user_registration_path, class: "btn btn-primary btn-lg rounded-md px-10 shadow-lg hover:shadow-xl transition-all" do %>
            Join Today
          <% end %>
          <%= link_to "#contact", class: "btn btn-outline btn-lg border-primary text-primary hover:bg-primary hover:text-white rounded-md px-10 transition-all" do %>
            Contact Us
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <!-- Simple Footer -->
  <footer class="bg-white py-12 border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-8">
        <div class="flex items-center gap-4">
          <img src="https://www.history-education.org/wp-content/uploads/2025/12/Gemini_Generated_Image_f0itlof0i.png" alt="Logo" class="h-10 w-auto">
          <span class="text-slate-400">|</span>
          <p class="text-slate-500 text-sm font-medium uppercase tracking-widest">History & Media Education</p>
        </div>
        <div class="flex gap-8 text-slate-400">
          <a href="#" class="hover:text-primary transition-colors"><i class="fab fa-facebook-f text-lg"></i></a>
          <a href="#" class="hover:text-primary transition-colors"><i class="fab fa-twitter text-lg"></i></a>
          <a href="#" class="hover:text-primary transition-colors"><i class="fab fa-instagram text-lg"></i></a>
        </div>
      </div>
      <div class="mt-12 pt-8 border-t border-slate-50 text-center">
        <p class="text-slate-400 text-sm">
          Copyright 2025 – History Education. All rights reserved.
        </p>
      </div>
    </div>
  </footer>
</div>