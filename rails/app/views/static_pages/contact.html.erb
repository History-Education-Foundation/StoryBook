<% content_for :full_width, true %>
<% content_for :hide_header, true %>
<% content_for :hide_navbar, true %>

<div class="min-h-screen bg-white font-sans text-slate-800">
  <%= render 'layouts/navigation' %>
  <!-- Custom Header -->
  <section class="bg-slate-900 py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-7xl font-bold text-white tracking-tight">Contact</h1>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 bg-white">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-slate-900 mb-4">Questions? We're here to help!</h2>
        <div class="w-24 h-1 bg-[#f9a825] mx-auto"></div>
      </div>

      <div class="space-y-4">
        <!-- FAQ Item 1 -->
        <div class="collapse collapse-plus bg-slate-50 border border-slate-200 rounded-lg group">
          <input type="checkbox" class="peer" /> 
          <div class="collapse-title text-xl font-bold text-slate-900 peer-checked:text-[#f9a825] transition-colors">
            What areas do you service?
          </div>
          <div class="collapse-content text-slate-600 leading-relaxed">
            <p>We provide educational resources and programs that are accessible nationwide. Our digital platforms and lesson plans are used by educators and communities across the country to strengthen civic and media literacy.</p>
          </div>
        </div>

        <!-- FAQ Item 2 -->
        <div class="collapse collapse-plus bg-slate-50 border border-slate-200 rounded-lg group">
          <input type="checkbox" class="peer" /> 
          <div class="collapse-title text-xl font-bold text-slate-900 peer-checked:text-[#f9a825] transition-colors">
            How can I support your mission?
          </div>
          <div class="collapse-content text-slate-600 leading-relaxed">
            <p>You can support us by making a donation, volunteering for our community programs, or sharing our resources with your local schools and organizations. Every contribution helps us build a more informed and engaged public.</p>
          </div>
        </div>

        <!-- FAQ Item 3 -->
        <div class="collapse collapse-plus bg-slate-50 border border-slate-200 rounded-lg group">
          <input type="checkbox" class="peer" /> 
          <div class="collapse-title text-xl font-bold text-slate-900 peer-checked:text-[#f9a825] transition-colors">
            Do you offer physical resources for classrooms?
          </div>
          <div class="collapse-content text-slate-600 leading-relaxed">
            <p>Yes, while many of our resources are digital, we also provide printed lesson plans, kits, and materials for classroom use upon request. Contact our educational team for more information on receiving physical materials.</p>
          </div>
        </div>

        <!-- FAQ Item 4 -->
        <div class="collapse collapse-plus bg-slate-50 border border-slate-200 rounded-lg group">
          <input type="checkbox" class="peer" /> 
          <div class="collapse-title text-xl font-bold text-slate-900 peer-checked:text-[#f9a825] transition-colors">
            How can I get involved in local programs?
          </div>
          <div class="collapse-content text-slate-600 leading-relaxed">
            <p>We partner with local organizations to host workshops and civic engagement events. Check our website regularly for upcoming events in your area, or reach out to us if you're interested in hosting a program in your community.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="w-full">
    <div class="w-full h-[450px] bg-slate-200">
      <iframe 
        src="https://www.google.com/maps?q=San+Francisco+Centre&output=embed" 
        width="100%" 
        height="450" 
        style="border:0;" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    </div>
  </section>
</div>
